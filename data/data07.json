            {"id": "0659","word": "パゾヘアマ","reading": "ぱぞへあま","meaning_cn": "指南，手册，操作指南（修正乱码）","synonyms": ["マニュアル", "手引き", "ガイドブック", "操作説明書"],"antonyms": ["経験", "勘", "直感", "無指針"],"collocations": ["パゾヘアマ化", "パゾヘアマ本", "パゾヘアマに従う", "作業パゾヘアマ"],"examples": [{"jp": "アマチュアは余計なことをせずに、パゾヘアマに従って作業すればよい。","cn": "新手不用做多余的事，按照操作指南作业就行。"}],"image": "https://placehold.co/300x200?text=Pazohea Ma"},
            {"id": "0660","word": "DV","reading": "でぃーぶい","meaning_cn": "家庭暴力，家庭内暴力","synonyms": ["家庭内暴力", "虐待", "ドメスティック・バイオレンス", "夫婦暴力"],"antonyms": ["家庭平和", "夫婦円満", "温暖な家庭", "相互尊重"],"collocations": ["DV被害", "DVから逃れる", "DV対策", "DV相談"],"examples": [{"jp": "DVから逃れられない人はたいてい、「あの人は自分がいなくなるとだめになってしまって、可哀想だから別れられない。」と言う。","cn": "无法逃离家庭暴力的人，大多会说“那个人没有我就不行了，太可怜了，所以离不开他”。"}],"image": "https://placehold.co/300x200?text=DV"},
