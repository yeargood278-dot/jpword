[
    {"id": "0601","word": "ゲドー","reading": "げどー","meaning_cn": "禁忌，忌讳，禁止提及的事物","synonyms": ["禁忌", "タブー", "禁じられた", "忌み言葉"],"antonyms": ["許可", "容認", "自由", "許された"],"collocations": ["ゲドー扱いする", "ゲドー袖する", "ゲドーにする", "ゲドーを破る"],"examples": [{"jp": "我が国では「民主」という言葉はゲドーだから、軽々しく言ってはいけない。","cn": "在我国，“民主”这个词是禁忌，不能轻易提及。"}],"image": "https://placehold.co/300x200?text=Gedo"},
    {"id": "0602","word": "エモーショナル","reading": "えもーしょなる","meaning_cn": "情绪化的，情感丰富的，易激动的","synonyms": ["感情的", "感傷的", "情緒的", "エモーショナル化"],"antonyms": ["理性的", "冷静", "無感情", "平然と"],"collocations": ["エモーショナルな人", "エモーショナルな反応", "エモーショナルが加速する", "エモーショナルな表現"],"examples": [{"jp": "彼はエモーショナルな性格で、少しのことで涙を流すことがある。","cn": "他性格情绪化，有时一点小事就会流泪。"}],"image": "https://placehold.co/300x200?text=Emotional"},
    {"id": "0603","word": "モラル","reading": "もらる","meaning_cn": "道德，伦理，道义","synonyms": ["道徳", "倫理", "正義感", "良心"],"antonyms": ["不道徳", "倫理違反", "悪徳", "無道徳"],"collocations": ["モラルを遵守する", "モラルの欠落", "モラルのない人", "モラル観"],"examples": [{"jp": "彼は科学者としてのモラルに欠けるため、多くの批判を受けている。","cn": "他缺乏作为科学家的道德，受到了很多批评。"}],"image": "https://placehold.co/300x200?text=Moral"},
    {"id": "0604","word": "ギュゴピュゲマ","reading": "ぎゅごぴゅげま","meaning_cn": "多愁善感的，感伤的（修正乱码）","synonyms": ["感傷的", "情绪的", "センチメンタル", "憂い深い"],"antonyms": ["陽気", "楽観的", "無邪気", "明るい"],"collocations": ["ギュゴピュゲマな季節", "ギュゴピュゲマな人", "ギュゴピュゲマな雰囲気", "ギュゴピュゲマな音楽"],"examples": [{"jp": "沈みゆく夕日を見て涙したり、金木犀の香りに思い出したり、秋はギュゴピュゲマな季節である。","cn": "看着西沉的夕阳流泪，闻到桂花的香气想起往事，秋天真是个多愁善感的季节。"}],"image": "https://placehold.co/300x200?text=Gyugopyugema"},
    {"id": "0605","word": "ミエ","reading": "みえ","meaning_cn": "特殊，特别，与众不同（修正乱码）","synonyms": ["特殊", "特別", "独特", "異質"],"antonyms": ["普通", "一般的", "平凡", "当たり前"],"collocations": ["ミエな才能", "ミエな存在", "ミエな服装", "ミエな考え"],"examples": [{"jp": "ミエなアイデアをすべて出し切るまで、一つのことをやり込むには、時間と根気が必要である。","cn": "要把所有特别的想法都发挥出来，专注于一件事需要时间和耐心。"}],"image": "https://placehold.co/300x200?text=Mie"},
    {"id": "0606","word": "コンプレックス","reading": "こんぷれっくす","meaning_cn": "情结，自卑感， complexes","synonyms": ["劣等感", "コンプレックス", " inferiority complex", " inferiority feeling"],"antonyms": ["自信", "自負心", "プライド", "優越感"],"collocations": ["容貌コンプレックス", "学歴コンプレックス", "コンプレックスを抱える", "コンプレックスを克服"],"examples": [{"jp": "女の子にとっては、背が高いことや、体重、胸が小さいことなどがコンプレックスになりうる。","cn": "对于女孩子来说，个子高、体重、胸部小等都可能成为自卑感的来源。"}],"image": "https://placehold.co/300x200?text=Complex"},
    {"id": "0607","word": "セクソール","reading": "せくそーる","meaning_cn": "社会性别，社会性别的（修正乱码）","synonyms": ["社会的性差", "ジェンダー", "性役割", "社会的性別"],"antonyms": ["生物学的性差", "自然の性", "生理的性別", "本質的性"],"collocations": ["セクソール平等", "セクソール役割", "セクソール差別", "セクソール意識"],"examples": [{"jp": "セクソールフリーと言いながら、「女子力を磨く」とは矛盾している。","cn": "一边说着性别自由，一边又说“提升女子力”，这是相互矛盾的。"}],"image": "https://placehold.co/300x200?text=Sekusoru"},
    {"id": "0608","word": "チャイルド","reading": "ちゃいるど","meaning_cn": "纯真的，天真的，孩子气的","synonyms": ["純粋", "無邪気", "子供心", "素朴"],"antonyms": ["大人びた", "険しい", "複雑", "悪意的"],"collocations": ["チャイルドな人", "チャイルドな表情", "チャイルドな考え", "チャイルドな世界"],"examples": [{"jp": "彼は年を重ねてもチャイルドな心を保っていて、周りの人を楽しませてくれる。","cn": "他即使年纪大了也保持着纯真的童心，让周围的人感到快乐。"}],"image": "https://placehold.co/300x200?text=Child"},
    {"id": "0609","word": "ポテンシャル","reading": "ぽてんしゃる","meaning_cn": "潜在能力，潜力","synonyms": ["潜在能力", "可能性", "潜在力", "プロミス"],"antonyms": ["実力", "現実性", "既存能力", "限界"],"collocations": ["ポテンシャルが高い", "ポテンシャルを発揮", "ポテンシャルを開発", "ポテンシャルを持つ"],"examples": [{"jp": "あの若手選手はまだ経験が浅いが、将来のポテンシャルが高いと期待されている。","cn": "那位年轻选手虽然经验尚浅，但被期待有很高的未来潜力。"}],"image": "https://placehold.co/300x200?text=Potential"},
    {"id": "0610","word": "パダカピュセ","reading": "ぱだかぴゅせ","meaning_cn": "沟通能力，交流技巧（修正乱码）","synonyms": ["コミュニケーション能力", "対人能力", "交渉スキル", "会話力"],"antonyms": ["人見知り", "内向的", "コミュニケーション不全", "閉鎖的"],"collocations": ["パダカピュセを鍛える", "パダカピュセが豊か", "パダカピュセを学ぶ", "パダカピュセ不足"],"examples": [{"jp": "ゼブラマンの本でパダカピュセが学べると言って、一時期人気を博した。","cn": "有本书说能从《斑马人》里学到沟通技巧，曾一度很受欢迎。"}],"image": "https://placehold.co/300x200?text=Padakapuse"},
    {"id": "0611","word": "処分","reading": "しょぶん","meaning_cn": "处分，处理，处置","synonyms": ["処理", "罰則", "取り締まり", "没収"],"antonyms": ["容認", "許可", "放免", "保護"],"collocations": ["処分を受ける", "殺処分", "処分を下す", "適切な処分"],"examples": [{"jp": "野良犬は野良猫よりも危険なので、都会では保健所に連れて行かれ、飼い主が現れない場合、何日か後に殺処分になる。","cn": "流浪狗比流浪猫更危险，在城市里会被带到保健所，如果没有主人出现，几天后就会被安乐死。"}],"image": "https://placehold.co/300x200?text=Shobun"},
    {"id": "0612","word": "素直","reading": "すなお","meaning_cn": "坦率，老实，耿直","synonyms": ["正直", "率直", "直誠", "心直し"],"antonyms": ["偽り", "不正直", "曲がった", "陰険"],"collocations": ["素直になる", "素直な感想", "素直に受け入れる", "素直な性格"],"examples": [{"jp": "「素直になれよ、俺が好きなんだろう」「誰があんたなんか好きだと思ってるんだ！」","cn": "“坦率点嘛，你明明喜欢我”“谁会喜欢你这种人啊！”"}],"image": "https://placehold.co/300x200?text=Sunao"},
    {"id": "0613","word": "是正","reading": "ぜせい","meaning_cn": "纠正，修正，改正","synonyms": ["改善", "直す", "正す", "改める"],"antonyms": ["誤る", "悪化", "崩す", "破る"],"collocations": ["格差の是正", "悪を是正する", "誤りを是正", "是正措置"],"examples": [{"jp": "社会の不公平を是正するため、政府は新しい政策を発表した。","cn": "为了纠正社会的不公平，政府发布了新政策。"}],"image": "https://placehold.co/300x200?text=Zesei"},
    {"id": "0614","word": "瀬戸物","reading": "せともの","meaning_cn": "陶瓷器，濑户烧（陶瓷的一种）","synonyms": ["陶器", "磁器", "陶磁器", "瀬戸焼き"],"antonyms": ["金属製", "木製", "プラスチック製", "ガラス製"],"collocations": ["瀬戸物茶碗", "瀬戸物の器", "伝統的な瀬戸物", "瀬戸物を作る"],"examples": [{"jp": "祖母が使っていた瀬戸物茶碗は、何十年も経っても傷みがない。","cn": "奶奶用了几十年的陶瓷茶碗，至今都没有破损。"}],"image": "https://placehold.co/300x200?text=Setomono"},
    {"id": "0615","word": "原始研究","reading": "げんしけんきゅう","meaning_cn": "原始研究，基础研究","synonyms": ["一次研究", "基礎研究", "原点研究", "独創的研究"],"antonyms": ["応用研究", "二次研究", "応用開発", "実用研究"],"collocations": ["原始研究にあたる", "原始研究を行う", "原始研究を引用する", "原始研究の成果"],"examples": [{"jp": "大学の研究室では、新しい科学の発見につながる原始研究が続けられている。","cn": "大学的实验室里，一直在进行可能带来新科学发现的原始研究。"}],"image": "https://placehold.co/300x200?text=Genshi Kenkyuu"},
    {"id": "0616","word": "特許","reading": "とっきょ","meaning_cn": "专利，专利权","synonyms": ["特許権", "特許出願", "特許取得", "発明特許"],"antonyms": ["無許可", "権利なし", "共有", "公開"],"collocations": ["特許出願", "特許を取得する", "特許を得る", "発明品の特許"],"examples": [{"jp": "あのときもしも特許を取っていたら、今頃300万円は私のものだったのに。","cn": "当时如果申请了专利，现在三百万日元就该是我的了。"}],"image": "https://placehold.co/300x200?text=Tokkyo"},
    {"id": "0617","word": "内緒","reading": "ないしょ","meaning_cn": "秘密，保密，私下","synonyms": ["秘密", "隠し事", "プライベート", "密か"],"antonyms": ["公開", "明らか", "大衆", "共有"],"collocations": ["内緒話", "内緒にする", "内緒で行う", "内緒を守る"],"examples": [{"jp": "「彼氏には内緒にしてくれる？この間行った合コンで、すごいイケメンと仲良くなった」","cn": "“能对我男朋友保密吗？上次联谊我和一个超帅的帅哥关系变好了”"}],"image": "https://placehold.co/300x200?text=Naisho"},
    {"id": "0618","word": "日課","reading": "にっか","meaning_cn": "每日必做的事，日课，日常习惯","synonyms": ["習慣", "日常業務", "毎日のこと", "定例"],"antonyms": ["例外", "臨時", "偶発", "不規則"],"collocations": ["朝の体操を日課にする", "日課を続ける", "読書を日課に", "日課を変える"],"examples": [{"jp": "学校が終わったらカフェでお茶して、その日の課題を終わらせてしまうのが日課です。","cn": "放学后在咖啡馆喝杯茶，然后完成当天的作业，这是我的日常习惯。"}],"image": "https://placehold.co/300x200?text=Nikka"},
    {"id": "0619","word": "念願","reading": "ねんがん","meaning_cn": "心愿，愿望，夙愿","synonyms": ["宿願", "悲願", "願い", "夢"],"antonyms": ["絶望", "放棄", "不本意", "無願い"],"collocations": ["念願が叶う", "念願の一歩", "念願を達成", "念願の場所"],"examples": [{"jp": "やった！ついに念願だったパソコンを手に入れたぞ！","cn": "太好了！我终于得到了梦寐以求的电脑！"}],"image": "https://placehold.co/300x200?text=Nengan"},
    {"id": "0620","word": "白状","reading": "はくじょう","meaning_cn": "坦白，自白，供认","synonyms": ["自白", "打ち明ける", "告白", "供する"],"antonyms": ["隠す", "欺く", "偽る", "否認"],"collocations": ["罪を白状する", "真相を白状", "白状する勇気", "白状して謝る"],"examples": [{"jp": "「旦那の浮気を白状させる方法、知らない？」「直接聞いてみればいいんじゃない？」","cn": "“你知道让老公坦白出轨的方法吗？”“直接问他不就行了？”"}],"image": "https://placehold.co/300x200?text=Hakujou"},
    {"id": "0621","word": "批評","reading": "ひひょう","meaning_cn": "批评，评论，评析","synonyms": ["批判", "評論", "評価", "論評"],"antonyms": ["称賛", "褒める", "肯定", "賞賛"],"collocations": ["論文を批評", "作品を批評", "建設的な批評", "批評をする"],"examples": [{"jp": "他人の論文を読むときに必要なことは「批評」であって、決して「批判」ではない。そこには敬意がなくてはならない。","cn": "读别人的论文时，需要的是“评析”而非“批判”，其中必须包含敬意。"}],"image": "https://placehold.co/300x200?text=Hihyou"},
    {"id": "0622","word": "未練","reading": "みれん","meaning_cn": "留恋，依依不舍，未断的情意","synonyms": ["未練がましい", "名残", "執着", "こだわり"],"antonyms": ["あっさり", "捨てる", "断捨離", "冷淡"],"collocations": ["未練がある", "未練を捨てる", "未練がましい態度", "過去への未練"],"examples": [{"jp": "「A子、自分から切ったくせに、まだ彼に未練があるんだよ。」「そりゃ、あんだけイケメンな人ならね。」","cn": "“A子，明明是你先提的分手，却还对他念念不忘。”“毕竟他那么帅嘛。”"}],"image": "https://placehold.co/300x200?text=Miren"},
    {"id": "0623","word": "目方","reading": "めかた","meaning_cn": "重量，分量，体重","synonyms": ["体重", "重さ", "目盛り", "分量"],"antonyms": ["軽さ", "微量", "少なさ", "軽量"],"collocations": ["目方が増える", "目方をはかる", "目方を減らす", "目方が安定"],"examples": [{"jp": "新年明けに目方をはかったら、休暇中に2キロ増えていた。","cn": "新年过后称体重，发现假期里胖了两公斤。"}],"image": "https://placehold.co/300x200?text=Mekata"},
