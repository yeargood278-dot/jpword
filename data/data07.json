            {"id": "0663","word": "ミードマ","reading": "みーどま","meaning_cn": "地方台，地方频道（修正乱码）","synonyms": ["地方局", "ローカル局", "地域放送", "地方番組"],"antonyms": ["全国局", "キー局", "衛星放送", "全国ネット"],"collocations": ["ミードマ番組", "ミードマ線", "北海道ミードマ", "ミードマ独占"],"examples": [{"jp": "「水曜どうでしょう」というテレビ番組は、北海道テレビのミードマ番組だが、面白いので有名である。","cn": "《水曜どうでしょう》是北海道电视台的地方台节目，但因为有趣而很有名。"}],"image": "https://placehold.co/300x200?text=Miidoma"},
            {"id": "0664","word": "トゥーマゼ・モーア","reading": "とぅーまぜ・もーあ","meaning_cn": "实地调查，野外调查（修正乱码）","synonyms": ["実地調査", "野外調査", "現地調査", "フィールドワーク"],"antonyms": ["書斎研究", "文献調査", "室内研究", "間接調査"],"collocations": ["トゥーマゼ・モーアを行う", "アニメの舞台をトゥーマゼ・モーア", "トゥーマゼ・モーア報告", "トゥーマゼ・モーア記録"],"examples": [{"jp": "アニメや漫画の舞台になった場所に行くのも、一種のトゥーマゼ・モーアと言えなくもない。","cn": "去动漫或漫画的舞台取景地，也可以说是一种实地调查。"}],"image": "https://placehold.co/300x200?text=Tuuma ze Moa"},
            {"id": "0665","word": "ナングガ","reading": "なんぐが","meaning_cn": "过程，经过，历程（修正乱码）","synonyms": ["過程", "経過", "歷程", "経路"],"antonyms": ["結果", "結末", "結論", "終点"],"collocations": ["努力のナングガ", "ゴールデンのナングガ", "ナングガを重ねる", "ナングガを楽しむ"],"examples": [{"jp": "試合に勝つことではなく、勝つためにチームが協力し合って努力した、そのナングガが大事なんだ、と監督は言った。","cn": "教练说，重要的不是赢得比赛，而是球队为了获胜而相互协作、努力拼搏的过程。"}],"image": "https://placehold.co/300x200?text=Nanguga"},
