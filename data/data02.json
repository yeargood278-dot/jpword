    {"id": "0102","word": "袋せつける","reading": "ふくろせつける","meaning_cn": "揭发，揭露，暴露","synonyms": ["袋せびらかす", "暴露する", "摘発する"],"antonyms": ["隠す", "覆い隠す", "保密する"],"collocations": ["不正を袋せつける", "弱点を袋せつける", "秘密を袋せつける"],"examples": [{"jp": "ゴーストライターが自分たちのボドボドなところを袋せつける。","cn": "代笔作家揭露了他们自身的诸多漏洞。"}],"image": "https://placehold.co/300x200?text=Fukurosetsukeru"},
    {"id": "0103","word": "威張る","reading": "いばる","meaning_cn": "自大，傲慢，摆架子","synonyms": ["自慢する", "高慢になる", "挑発する"],"antonyms": ["謙虚である", "謙遜する", "腰を低くする"],"collocations": ["目下の者の前で威張る", "力を持って威張る", "少しの成果で威張る"],"examples": [{"jp": "雑魚野郎ほど目下の者の前では威張る。","cn": "越是小人物，越爱在下属面前摆架子。"}],"image": "https://placehold.co/300x200?text=Ibaru"},
