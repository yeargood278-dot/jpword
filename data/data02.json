    {"id": "0105","word": "言葉を交わす","reading": "ことばをかわす","meaning_cn": "交谈，搭话，交流","synonyms": ["話す", "声をかける", "交流する"],"antonyms": ["無言でいる", "疎遠にする", "対立する"],"collocations": ["偶然会って言葉を交わす", "意見を交わす", "心を開いて言葉を交わす"],"examples": [{"jp": "彼とは特別な関係でもなく、仲が悪い訳でもなく、ただ会ったら言葉を交わす程度の間柄である。","cn": "我和他既没有特殊关系，也没有交恶，只是见面了会打个招呼、简单聊几句的关系。"}],"image": "https://placehold.co/300x200?text=Kotobawokawasu"},
    {"id": "0106","word": "無理やり","reading": "むりやり","meaning_cn": "强行，硬逼，勉强","synonyms": ["無理強いする", "強制する", "押し付ける"],"antonyms": ["自発的に", "進んで", "心から"],"collocations": ["無理やりにする", "無理やりに連れ去る", "無理やりに承認させる"],"examples": [{"jp": "無理やりやらせても、本当の学力は身につかない。","cn": "就算强行让他学习，也无法真正掌握学识。"}],"image": "https://placehold.co/300x200?text=Muryari"},
    {"id": "0107","word": "いきいき","reading": "いきいき","meaning_cn": "生动，活泼，栩栩如生","synonyms": ["活気がある", "生き生きとした", "生気勃勃な"],"antonyms": ["無機質な", "生気のない", "つまらない"],"collocations": ["いきいきした声", "いきいきとした表情", "いきいきと描かれた絵"],"examples": [{"jp": "あなたは電車の話題になると、途端にいきいきするね。","cn": "你一谈到电车的话题，就立刻变得兴致勃勃呢。"}],"image": "https://placehold.co/300x200?text=Ikiki"},
    {"id": "0108","word": "あっけない","reading": "あっけない","meaning_cn": "乏味，没意思，扫兴","synonyms": ["つまらない", "物足りない", "簡単すぎる"],"antonyms": ["興奮する", "刺激的な", "充実した"],"collocations": ["あっけなく終わる", "あっけない結果", "あっけない勝利"],"examples": [{"jp": "五年付き合ったわりには、あっけない別れだった。","cn": "毕竟交往了五年，这样的分手也太草率乏味了。"}],"image": "https://placehold.co/300x200?text=Akkenai"},
    {"id": "0109","word": "あくまでも","reading": "あくまでも","meaning_cn": "终究，到底，彻底","synonyms": ["到底", "最後まで", "決して"],"antonyms": ["一時的に", "部分的に", "大概"],"collocations": ["あくまでも主張を貫く", "あくまでも自分の意見を持つ", "あくまでも規則に従う"],"examples": [{"jp": "勘違いしないでよね、あんたに構うのは、あくまで私のためなんだから。","cn": "别误会哦，我之所以对你好，说到底都是为了我自己。"}],"image": "https://placehold.co/300x200?text=Akumademo"},
    {"id": "0110","word": "ひたすら","reading": "ひたすら","meaning_cn": "专心，一心一意，只顾","synonyms": ["一心不乱に", "ひたむきに", "ひたすらに"],"antonyms": ["三心二意で", "中途半端に", "分散して"],"collocations": ["ひたすら練習する", "ひたすら働く", "ひたすら前進する"],"examples": [{"jp": "ひたすらに練習した結果、大会で優勝することができた。","cn": "经过专心致志的练习，终于在比赛中获得了冠军。"}],"image": "https://placehold.co/300x200?text=Hitasura"},
