    {"id": "0406","word": "コンタクト","reading": "こんたくと","meaning_cn": "接触，联系，隐形眼镜","synonyms": ["接触する", "連絡する", "つながる", "コンタクトレンズ"],"antonyms": ["隔たり", "断絶", "距離", "遠ざかる"],"collocations": ["コンタクトを取る", "コンタクトレンズをつける", "コンタクトを維持", "海外とコンタクト"],"examples": [{"jp": "長年連絡が途絶えていた友人と、偶然コンタクトを取ることができた。","cn": "我偶然和多年失去联系的朋友重新取得了联系。"}],"image": "https://placehold.co/300x200?text=Contakuto"},
    {"id": "0407","word": "怯える","reading": "おびえる","meaning_cn": "害怕，畏惧，胆怯","synonyms": ["恐れる", "怖がる", "震える", "臆病になる"],"antonyms": ["勇気がある", "恐れない", "大胆", "度胸がある"],"collocations": ["幽霊に怯える", "暗闇に怯える", "危険に怯える", "怯えて震える"],"examples": [{"jp": "子供の頃、暗い部屋に一人でいると幽霊が出てくるので怯えた。","cn": "小时候，一个人在黑暗的房间里会害怕幽灵出现。"}],"image": "https://placehold.co/300x200?text=Obieru"},
