        {"id": "0456","word": "そもそも","reading": "そもそも","meaning_cn": "本来，原本，说到底","synonyms": ["元もと", "当初", "根本的に", "始めから"],"antonyms": ["後から", "途中で", "一時的に", "派生的に"],"collocations": ["そもそもの原因", "そもそもの目的", "そもそも考えられない", "そもそもだから"],"examples": [{"jp": "そもそも君が約束を守らなかったのだから、こうなったのは当然だ。","cn": "本来就是你没遵守约定，所以变成这样也是理所当然。"}],"image": "https://placehold.co/300x200?text=Somosomo"},
        {"id": "0457","word": "なんだか","reading": "なんだか","meaning_cn": "总觉得，不知怎么地，不由得","synonyms": ["なんとなく", "どことなく", "何とか", "なぜか"],"antonyms": ["明確に", "はっきりと", "確かに", "明らかに"],"collocations": ["なんだか怪しい", "なんだか嬉しい", "なんだか疲れる", "なんだか不自然"],"examples": [{"jp": "今日はなんだか体調が悪くて、何もしたくない。","cn": "今天总觉得身体不舒服，什么都不想做。"}],"image": "https://placehold.co/300x200?text=Nandaka"},
        {"id": "0458","word": "にこにこ","reading": "にこにこ","meaning_cn": "笑眯眯，笑嘻嘻，微笑着","synonyms": ["にっこり", "微笑む", "嬉しそうに", "満面の笑み"],"antonyms": ["泣き顔", "悲しそう", "不機嫌", "眉をしかめる"],"collocations": ["にこにこ笑う", "にこにこして話す", "にこにこした表情", "にこにこしながら"],"examples": [{"jp": "「どうしたの、にこにこして？」「さっき五百円玉を拾ったんだよ！」","cn": "“你怎么笑眯眯的？”“我刚才捡到了五百日元硬币呀！”"}],"image": "https://placehold.co/300x200?text=Nikoniko"},
        {"id": "0459","word": "遅くとも","reading": "おそくとも","meaning_cn": "最迟，最晚，至迟","synonyms": ["最遅で", "遅くても", "少なくとも", "これまでに"],"antonyms": ["できるだけ早く", "速やかに", "早期に", "急いで"],"collocations": ["遅くとも明日まで", "遅くとも夜中まで", "遅くとも完成", "遅くとも返却"],"examples": [{"jp": "この書類は遅くとも明後日までに提出してください。","cn": "这份文件最迟请在后天提交。"}],"image": "https://placehold.co/300x200?text=Osokutomo"},
