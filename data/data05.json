    {"id": "0432","word": "恥の文化","reading": "はじのぶんか","meaning_cn": "耻感文化（重视他人评价的文化）","synonyms": ["他者評価重視", "恥意識", "表面的な文化", "建前文化"],"antonyms": ["罪の文化", "自己評価重視", "内面的な文化", "本音文化"],"collocations": ["日本の恥の文化", "恥の文化を持つ", "恥の文化の特徴", "恥の文化と罪の文化"],"examples": [{"jp": "ベネディクトは日本文化を「他者の目を気にする恥の文化」と分析した。","cn": "本尼迪克特将日本文化分析为“重视他人眼光的耻感文化”。"}],"image": "https://placehold.co/300x200?text=Haji no Bunka"},
    {"id": "0433","word": "価値観","reading": "かちかん","meaning_cn": "价值观","synonyms": ["価値判断", "価値体系", "考え方", "信念"],"antonyms": ["価値観の違い", "考えの相違", "信念の不一致"],"collocations": ["新しい価値観", "価値観を共有", "価値観が合う", "価値観を形成"],"examples": [{"jp": "世代が違うと価値観が異なることが多いが、相互理解が重要だ。","cn": "不同世代的人往往价值观不同，但相互理解很重要。"}],"image": "https://placehold.co/300x200?text=Kachikan"},
    {"id": "0434","word": "パラドックス","reading": "ぱらどっくす","meaning_cn": "悖论，矛盾，二律背反","synonyms": ["逆説", "矛盾", "二律背反", "矛盾現象"],"antonyms": ["合理", "一貫性", "論理的", "矛盾のない"],"collocations": ["パラドックスを解く", "有名なパラドックス", "パラドックスが生じる", "パラドックス的な状況"],"examples": [{"jp": "「落書き禁止」の壁に「落書きするべからず」と書くのは、パラドックスだ。","cn": "在“禁止涂鸦”的墙上写“禁止涂鸦”，这是一种悖论。"}],"image": "https://placehold.co/300x200?text=Paradokkusu"},
        {"id": "0435","word": "楽観主義","reading": "らっかんしゅぎ","meaning_cn": "乐观主义","synonyms": ["楽観的", "陽気", "前向き", "楽天的"],"antonyms": ["悲観主義", "悲観的", "陰気", "めげやすい"],"collocations": ["楽観主義者", "楽観主義的な考え", "楽観主義を持つ", "楽観主義に傾く"],"examples": [{"jp": "彼はいつも楽観主義で、どんな困難にも前向きに挑戦する。","cn": "他总是乐观主义者，积极面对任何困难。"}],"image": "https://placehold.co/300x200?text=Rakkan Shugi"},
        {"id": "0436","word": "耽美","reading": "たんび","meaning_cn": "耽美，追求美，唯美（现多指BL相关）","synonyms": ["耽美主義", "美を追求", "唯美主義", "BL"],"antonyms": ["実用主義", "功利主義", "地味", "実務的"],"collocations": ["耽美小説", "耽美主義者", "耽美文化", "耽美作品"],"examples": [{"jp": "昔は谷崎潤一郎の小説が耽美の代表だったが、近年はBL作品を指すことが多い。","cn": "以前谷崎润一郎的小说是耽美的代表，近年则多指代BL作品。"}],"image": "https://placehold.co/300x200?text=Tanbi"},
        {"id": "0437","word": "当たり障りがない","reading": "あたりさわりがない","meaning_cn": "不得罪人的，稳妥的，无懈可击的","synonyms": ["無難", "安全", "問題ない", "皆に合う"],"antonyms": ["直接的", "率直", "当たり障りがある", "刺激的"],"collocations": ["当たり障りのない返事", "当たり障りのない服装", "当たり障りのない話", "当たり障りのない態度"],"examples": [{"jp": "面接では当たり障りのない返事をするより、真心を込めて話した方が良い。","cn": "面试时与其说些不得罪人的话，不如真诚地表达自己。"}],"image": "https://placehold.co/300x200?text=Atarisa wari ga Nai"},
        {"id": "0438","word": "相槌を打つ","reading": "あいづちをうつ","meaning_cn": "附和，随声附和，搭话","synonyms": ["同意する", "賛成する", "空気を読む", "迎合する"],"antonyms": ["反対する", "反論する", "KY", "反発する"],"collocations": ["相槌を打って傾聴", "適切に相槌を打つ", "相槌を打って会話を続け", "積極的に相槌を打つ"],"examples": [{"jp": "彼が聞き上手なのは、相槌のタイミングが絶妙なんだ。","cn": "他很会倾听，因为附和的时机恰到好处。"}],"image": "https://placehold.co/300x200?text=Aizuchi wo Utsu"},
        {"id": "0439","word": "訛り","reading": "なまり","meaning_cn": "口音，腔调，方言口音","synonyms": ["方言", "訛り話し", "腔調", "地方語の特徴"],"antonyms": ["標準語", "共通語", "標準的な発音", "きれいな語り"],"collocations": ["南部訛り", "関西訛り", "訛りが強い", "訛りを消す"],"examples": [{"jp": "彼の話には故郷の訛りが残っていて、温かみがある。","cn": "他的话里还带着家乡的口音，很亲切。"}],"image": "https://placehold.co/300x200?text=Namari"},
        {"id": "0440","word": "方言","reading": "ほうげん","meaning_cn": "方言，地方话","synonyms": ["訛り", "地方語", "郷土語", "方言話し"],"antonyms": ["標準語", "共通語", "全国共通語", "標準発音"],"collocations": ["関西弁", "东北方言", "方言を話す", "方言の特徴"],"examples": [{"jp": "日本には都道府県ごとに独特の方言が存在する。","cn": "日本每个都道府县都有独特的方言。"}],"image": "https://placehold.co/300x200?text=Hougen"},
        {"id": "0441","word": "潰す","reading": "つぶす","meaning_cn": "压碎，毁坏，消灭，击溃","synonyms": ["踏みつける", "破壊する", "潰滅させる", "圧力をかける"],"antonyms": ["保護する", "守る", "建設する", "立てる"],"collocations": ["ゴミを潰す", "敵を潰す", "夢を潰す", "潰れる", "握り潰す"],"examples": [{"jp": "硬いガムを歯で潰すのは、歯を痛める原因になる。","cn": "用牙齿咬碎硬口香糖会损伤牙齿。"}],"image": "https://placehold.co/300x200?text=Tsubusu"},
        {"id": "0442","word": "馴染む","reading": "なじむ","meaning_cn": "适应，习惯，融洽，贴合","synonyms": ["慣れる", "適応する", "打ち解ける", "合う"],"antonyms": ["慣れない", "適応しない", "他人行儀", "離れる"],"collocations": ["新しい環境に馴染む", "靴が馴染む", "人と馴染む", "馴染みやすい性格"],"examples": [{"jp": "新しい学校に転校して一週間、やっとクラスメイトと馴染んだ。","cn": "转学到新学校一周后，我终于和同学融洽相处了。"}],"image": "https://placehold.co/300x200?text=Najimu"},
        {"id": "0443","word": "ためらう","reading": "ためらう","meaning_cn": "犹豫，踌躇，迟疑","synonyms": ["躊躇する", "思いとどまる", "踏みとどまる", "迷う"],"antonyms": ["即断即決", "思い切る", "勇気を出す", "決断する"],"collocations": ["告白するのをためらう", "ためらって機会を逃す", "ためらいながら行動", "ためらいを捨てる"],"examples": [{"jp": "好きな人に告白するのをためらっている間に、彼が他の人と付き合い始めた。","cn": "我犹豫着要不要向喜欢的人告白，他却开始和别人交往了。"}],"image": "https://placehold.co/300x200?text=Tamerau"},
        {"id": "0444","word": "つぶやく","reading": "つぶやく","meaning_cn": "嘟囔，小声说，自言自语","synonyms": ["ささやく", "小声で話す", "独り言を言う", "ブツブツ言う"],"antonyms": ["大声で言う", "朗読する", "公に発表", "はっきり話す"],"collocations": ["つぶやいて不満を漏らす", "独り言をつぶやく", "つぶやきながら考える", "眠る前につぶやく"],"examples": [{"jp": "授業で新しく習った単語をつぶやいていると、自然に覚えられる。","cn": "小声嘟囔着上课新学的单词，就能自然而然记住。"}],"image": "https://placehold.co/300x200?text=Tsubuyaku"},
        {"id": "0445","word": "～にもほどがある","reading": "～にもほどがある","meaning_cn": "…也该有个限度，太…了","synonyms": ["あまりにも～", "限度がある", "～すぎる", "度が過ぎる"],"antonyms": ["適度に～", "ほどほど", "適切", "節度がある"],"collocations": ["無責任にもほどがある", "うるさいにもほどがある", "遅刻にもほどがある", "わがままにもほどがある"],"examples": [{"jp": "自分の仕事を他人に押し付けて早退するなんて、無責任にもほどがある。","cn": "把自己的工作推给别人然后早退，也太不负责任了。"}],"image": "https://placehold.co/300x200?text=Ni mo Hodo ga Aru"},
        {"id": "0446","word": "ずれる","reading": "ずれる","meaning_cn": "错位，偏离，偏差，错位","synonyms": ["逸れる", "外れる", "ずらす", "はみ出る"],"antonyms": ["一致する", "合う", "噛み合う", "正しい位置"],"collocations": ["時刻がずれる", "位置がずれる", "ズレが生じる", "ずれを修正"],"examples": [{"jp": "時計の針がずれているので、正確な時間が分からない。","cn": "时钟的指针错位了，不知道准确时间。"}],"image": "https://placehold.co/300x200?text=Zureru"},
        {"id": "0447","word": "切り出す","reading": "きりだす","meaning_cn": "开口说，提出，开始说（难开口的事）","synonyms": ["言い出す", "提起する", "話し始める", "切り返す"],"antonyms": ["黙る", "避ける", "中止する", "引っ込める"],"collocations": ["別れ話を切り出す", "難しい話を切り出す", "切り出しにくい話", "勇気を出して切り出す"],"examples": [{"jp": "結婚することを切り出すのに、彼は一ヶ月もためらった。","cn": "他犹豫了一个月才鼓起勇气提出结婚。"}],"image": "https://placehold.co/300x200?text=Kiridasu"},
