        {"id": "0233","word": "ゴールド","reading": "ゴールド","meaning_cn": "金，黄金，金色，金牌","synonyms": ["金", "黄金", "金色", "金貨"],"antonyms": ["銀", "プラチナ", "銅", "黒"],"collocations": ["ゴールドを渡す", "ゴールドを払う", "ゴールドメダル", "ゴールドカード"],"examples": [{"jp": "このアクセサリーは、純粋なゴールドで製造されている。","cn": "这件饰品是用纯金制作的。"}],"image": "https://placehold.co/300x200?text=Gorudo"},
        {"id": "0234","word": "デモ","reading": "デモ","meaning_cn": "示威游行，演示，试用","synonyms": ["デモンストレーション", "抗議行動", "デモ行進", "実演"],"antonyms": ["支持行動", "賛同", "受け入れ"],"collocations": ["デモを起こす", "デモをする", "デモ行進", "製品デモ"],"examples": [{"jp": "「さよなら原発お散歩デモ」というデモ行進が実在するらしい。","cn": "似乎真的存在一个叫“告别核电站散步示威”的游行活动。"}],"image": "https://placehold.co/300x200?text=Demo"},
        {"id": "0235","word": "手引き","reading": "てびき","meaning_cn": "指引，引导，指南，介绍","synonyms": ["案内書", "ガイド", "指針", "紹介"],"antonyms": ["迷惑", "障害", "邪魔", "誤導"],"collocations": ["旅の手引き", "仕事の手引き", "手引きをする", "入門手引き"],"examples": [{"jp": "新入社員のために、仕事の手引きを作成した。","cn": "为新员工制作了工作指南。"}],"image": "https://placehold.co/300x200?text=Tekibiki"},
        {"id": "0236","word": "にわか","reading": "にわか","meaning_cn": "突然，忽然，临时，骤雨","synonyms": ["突然", "急に", "即座", "にわか雨"],"antonyms": ["徐々に", "だんだん", "漸次", "計画的"],"collocations": ["にわか雨", "にわかに", "にわか風", "にわかに晴れる"],"examples": [{"jp": "にわか雨だからすぐに止むよ。慌てて雨宿りしなくても大丈夫。","cn": "这是骤雨，很快就会停的，不用急着找地方躲雨。"}],"image": "https://placehold.co/300x200?text=Niwaka"},
        {"id": "0237","word": "経緯","reading": "けいい","meaning_cn": "经过，原委，经纬，来龙去脉","synonyms": ["いきさつ", "経過", "経歴", "経路"],"antonyms": ["結果", "結末", "結論", "終わり"],"collocations": ["経緯を説明する", "事件の経緯", "事情の経緯", "経緯を話す"],"examples": [{"jp": "さて、私のお気に入りの花瓶が割れていて、部屋がめちゃくちゃになった経緯を説明してもらいましょうか。","cn": "那么，能给我说说为什么我心爱的花瓶碎了，房间还变得乱七八糟的来龙去脉吗？"}],"image": "https://placehold.co/300x200?text=Keii"},
        {"id": "0238","word": "稽古","reading": "けいこ","meaning_cn": "练习，研习，训练（尤指技艺、武术）","synonyms": ["練習", "トレーニング", "修行", "研鑽"],"antonyms": ["怠ける", "中止", "放棄", "休む"],"collocations": ["稽古に励む", "稽古をつける", "稽古を休む", "剣道の稽古"],"examples": [{"jp": "相撲の稽古には、よく食べ、よく寝ることも含まれる。","cn": "相扑的训练中，也包括吃饱睡好。"}],"image": "https://placehold.co/300x200?text=Keiko"},
        {"id": "0239","word": "軽蔑","reading": "けいべつ","meaning_cn": "轻蔑，轻视，藐视","synonyms": ["見下す", "侮る", "冷笑", "見くびる"],"antonyms": ["尊敬", "敬重", "畏敬", "重視"],"collocations": ["軽蔑する", "軽蔑の眼差し", "軽蔑の念", "人を軽蔑する"],"examples": [{"jp": "飲食店で店員さんに偉そうにする男の人って、軽蔑の対象だよね。","cn": "在餐厅里对店员摆架子的男人，真是让人鄙视。"}],"image": "https://placehold.co/300x200?text=Keibetsu"},
        {"id": "0240","word": "一桁","reading": "いっけた","meaning_cn": "一位数，个位数","synonyms": ["一桁の数字", "個位数", "一桁数", "単桁"],"antonyms": ["二桁", "多桁", "複数桁", "十桁以上"],"collocations": ["一桁を取る", "一桁を目指す", "一桁の得点", "一桁の誤差"],"examples": [{"jp": "インタビューで、「次の総選挙では一桁を目指します。」と、NMB48の山本彩は答えた。","cn": "在采访中，NMB48的山本彩回答说：“下次总选举的目标是进入个位数排名。”"}],"image": "https://placehold.co/300x200?text=Ikketa"},
        {"id": "0241","word": "結束","reading": "けつそく","meaning_cn": "团结，联合，凝聚力","synonyms": ["団結", "結びつき", "絆", "連携"],"antonyms": ["分裂", "離反", "不和", "瓦解"],"collocations": ["結束して事にあたる", "結束が強い", "結束を固める", "団体の結束"],"examples": [{"jp": "チームの結束が強ければ、どんな困難にも打ち勝てる。","cn": "只要团队凝聚力强，就能战胜任何困难。"}],"image": "https://placehold.co/300x200?text=Ketsusoku"},
        {"id": "0242","word": "気配","reading": "けはい","meaning_cn": "迹象，苗头，气息，动静","synonyms": ["兆し", "気配り", "痕跡", "动静"],"antonyms": ["無音", "痕跡がない", "気配がない", "静か"],"collocations": ["気配を感じる", "気配を消す", "気配が漏れる", "秋の気配"],"examples": [{"jp": "忍者は自分の気配を消すことができるので、敵に見つからない。","cn": "忍者能隐藏自己的气息，不被敌人发现。"}],"image": "https://placehold.co/300x200?text=Kehai"},
        {"id": "0243","word": "検討","reading": "けんとう","meaning_cn": "研究，探讨，审议，考虑","synonyms": ["吟味", "熟考", "検討", "議論"],"antonyms": ["即断", "即決", "即時決定", "無思考"],"collocations": ["検討する", "検討を重ねる", "検討の余地がある", "問題点を検討する"],"examples": [{"jp": "このプロジェクトの実行可能性について、チームで検討する。","cn": "团队将探讨这个项目的可行性。"}],"image": "https://placehold.co/300x200?text=Kentou"},
        {"id": "0244","word": "口実","reading": "こうじつ","meaning_cn": "借口，口实，托词","synonyms": ["言い訳", "託詞", "名目", "理由（偽り）"],"antonyms": ["本音", "真の理由", "实情", "本心"],"collocations": ["口実を与える", "口実を探す", "口実にする", "薄っぺらな口実"],"examples": [{"jp": "病気を口実にして学校を休み、アニメのイベントに参加した。","cn": "以生病为借口请假，去参加了动漫活动。"}],"image": "https://placehold.co/300x200?text=Koujitsu"},
        {"id": "0245","word": "監督","reading": "かんとく","meaning_cn": "监督，导演，教练，领队","synonyms": ["指導", "指揮", "ディレクター", "コーチ"],"antonyms": ["部下", "被指導者", "選手", "出演者"],"collocations": ["試験監督", "工事現場を監督する", "映画の監督", "チームの監督"],"examples": [{"jp": "「安西先生…バスケがしたいです…」の安西先生は、湘北高校バスケットボール部の監督である。","cn": "说着“安西教练…我想打篮球…”的安西教练，是湘北高中篮球队的教练。"}],"image": "https://placehold.co/300x200?text=Kantoku"},
        {"id": "0246","word": "素朴","reading": "そぼく","meaning_cn": "朴素，朴实，单纯，质朴","synonyms": ["地味", "質素", "単純", "純粋"],"antonyms": ["華やか", "複雑", "精巧", "装飾的"],"collocations": ["素朴な味わい", "素朴な家", "素朴な人", "素朴な考え"],"examples": [{"jp": "「一生懸命頑張ってご飯作ったの、たくさん食べて」「…素朴な味だね…」","cn": "“我努力做了饭，多吃点呀”“…味道很朴实呢…”"}],"image": "https://placehold.co/300x200?text=Soboku"},
        {"id": "0247","word": "ヒート","reading": "ヒート","meaning_cn": "热，热度，热情，加热","synonyms": ["熱", "熱気", "情熱", "加熱"],"antonyms": ["クール", "冷気", "冷静", "冷却"],"collocations": ["ヒートを感じる", "ヒートアップ", "情熱のヒート", "ヒートショック"],"examples": [{"jp": "『残酷な天使のテーゼ』という歌の一節にある「ほとばしる熱いヒート」とは、おそらく一種の興奮状態のことだろうと解釈されている。","cn": "歌曲《残酷天使的行动纲领》中“迸发的炽热热情”这一节，被认为大概是指一种兴奋的状态。"}],"image": "https://placehold.co/300x200?text=Hiito"},
        {"id": "0248","word": "パラダイス","reading": "パラダイス","meaning_cn": "天堂，乐园，极乐世界","synonyms": ["楽園", "桃源郷", "極楽", "理想郷"],"antonyms": ["地獄", "苦境", "困難地帯", "不幸"],"collocations": ["パラダイスを求める", "海辺のパラダイス", "愛のパラダイス", "パラダイスの島"],"examples": [{"jp": "どこにあるかもわからないパラダイスを追い求めるよりも、現実世界で小さな幸せを探したほうが良い。","cn": "与其追求不知存在于何处的天堂，不如在现实世界中寻找小小的幸福。"}],"image": "https://placehold.co/300x200?text=Paradaisu"},
        {"id": "0249","word": "ノスタルジア","reading": "ノスタルジア","meaning_cn": "怀旧，乡愁，思念故乡","synonyms": ["郷愁", "郷思", "懷かしさ", "思い出"],"antonyms": ["現実主義", "当時の不満", "未来志向"],"collocations": ["ノスタルジアを感じる", "ノスタルジアに浸る", "学生時代のノスタルジア", "故郷のノスタルジア"],"examples": [{"jp": "たとえ出身が都会であっても、農村や漁村ののどかな風景を見れば、ノスタルジアに浸ることができる。","cn": "即使出身在城市，看到农村或渔村宁静的风景，也会沉浸在怀旧情绪中。"}],"image": "https://placehold.co/300x200?text=Nostarujia"},
        {"id": "0250","word": "形而上","reading": "けいじじょう","meaning_cn": "形而上学，抽象的，精神层面的","synonyms": ["抽象的", "精神的", "哲学的", "観念的"],"antonyms": ["形而下", "物質的", "具体的", "現実的"],"collocations": ["形而上の思考", "形而上の問題", "形而上の世界", "形而上的な考察"],"examples": [{"jp": "哲学の授業で、形而上の概念について討論した。","cn": "哲学课上，我们讨论了形而上学的概念。"}],"image": "https://placehold.co/300x200?text=Keijijou"},
            {"id": "0251","word": "演繹","reading": "えんえき","meaning_cn": "演绎，推论，演绎法","synonyms": ["推論", "演繹法", "推理", "帰納と対比"],"antonyms": ["帰納", "帰納法", "具体例", "経験則"],"collocations": ["演繹する", "演繹法を用いる", "論理的演繹", "演繹的思考"],"examples": [{"jp": "数学の証明では、公理から定理を演繹する手法がよく用いられる。","cn": "数学证明中，经常使用从公理推导出定理的演绎手法。"}],"image": "https://placehold.co/300x200?text=Eneki"},
            {"id": "0252","word": "しかも","reading": "しかも","meaning_cn": "而且，并且，加之，何况","synonyms": ["それに", "その上", "あまつさえ", "おまけに"],"antonyms": ["それに反して", "却って", "逆に"],"collocations": ["しかも～だ", "しかも～し", "しかも驚くことに", "しかも重要なのは"],"examples": [{"jp": "千葉雄大くんはイケメンでかわいい。しかも演技もうまくて人気だ。","cn": "千叶雄大既帅气又可爱，而且演技还好，很受欢迎。"}],"image": "https://placehold.co/300x200?text=Shikamo"},
            {"id": "0253","word": "ところが","reading": "ところが","meaning_cn": "然而，可是，不料","synonyms": ["しかし", "だが", "けれども", "意外にも"],"antonyms": ["したがって", "それ故", "だから", "結果"],"collocations": ["ところが～だ", "ところが～し", "ところが思いがけないことに", "ところが不幸にも"],"examples": [{"jp": "前を歩いていた人が財布を落としたので、拾ってあげた。ところが、お礼も言わずに去っていってしまった。","cn": "前面走的人掉了钱包，我捡起来还给了他，然而他却没说谢谢就走了。"}],"image": "https://placehold.co/300x200?text=Tokoroga"},
            {"id": "0254","word": "すなわち","reading": "すなわち","meaning_cn": "即，也就是说，换句话说","synonyms": ["つまり", "換言すれば", "言い換えれば", "このように"],"antonyms": ["漠然と", "不明確に", "曖昧に"],"collocations": ["すなわち～である", "すなわち～ということだ", "すなわち結論から言えば", "すなわち要するに"],"examples": [{"jp": "ガジェット業界の業績はこのところ良くありません。すなわち、ソフトウェアの一人勝ちということです。","cn": "数码产品行业最近的业绩不太好，也就是说，软件行业呈现出一家独大的局面。"}],"image": "https://placehold.co/300x200?text=Sunawachi"},
            {"id": "0255","word": "とにかく","reading": "とにかく","meaning_cn": "总之，不管怎样，好歹，姑且","synonyms": ["とにもかくにも", "とりあえず", "何はともあれ", "とかく"],"antonyms": ["詳しくは", "具体的には", "細かくは"],"collocations": ["とにかく～する", "とにかく先に", "とにかく結果は", "とにかく試してみる"],"examples": [{"jp": "本当にお腹が空いているんです。何でもいいですからとにかく食べられるものをください。","cn": "我真的很饿，什么都行，好歹给我点能吃的东西吧。"}],"image": "https://placehold.co/300x200?text=Tonikaku"},
            {"id": "0256","word": "とりあえず","reading": "とりあえず","meaning_cn": "暂且，姑且，先，首先","synonyms": ["いったん", "ひとまず", "暫定的に", "最初に"],"antonyms": ["本格的に", "最終的に", "徹底的に"],"collocations": ["とりあえず～する", "とりあえずこれで", "とりあえず報告", "とりあえず中止"],"examples": [{"jp": "「Aくんのこと、好きかどうか、わからないの…」「…とりあえず、付き合ってみる？」","cn": "“我不知道自己喜不喜欢A君…”“…姑且先试着交往看看？”"}],"image": "https://placehold.co/300x200?text=Toriaezu"},
            {"id": "0257","word": "ストレス","reading": "ストレス","meaning_cn": "压力，紧张感，应激反应","synonyms": ["緊張", "プレッシャー", "疲労", "精神的負担"],"antonyms": ["リラックス", "休養", "安らぎ", "ストレスフリー"],"collocations": ["ストレスが溜まる", "ストレスを発散", "ストレス性胃炎", "ストレスフルな環境"],"examples": [{"jp": "「最近、頭痛と胃炎が交互に来るんだけど」「ストレス、疲労、ストレス、疲労…」「やめて！」","cn": "“最近我头痛和胃炎交替发作”“压力、疲劳、压力、疲劳…”“别说了！”"}],"image": "https://placehold.co/300x200?text=Sutoresu"},
            {"id": "0258","word": "プレッシャー","reading": "プレッシャー","meaning_cn": "压力，压迫感，强制力","synonyms": ["圧力", "緊張感", "逼迫感", "圧迫"],"antonyms": ["寛容", "緩和", "自由", "開放感"],"collocations": ["プレッシャーを感じる", "プレッシャーをかける", "大きなプレッシャー", "プレッシャーに耐える"],"examples": [{"jp": "このプロジェクトが失敗したら大変な被害になる。ものすごいプレッシャーだ。","cn": "这个项目如果失败会造成巨大损失，真是巨大的压力。"}],"image": "https://placehold.co/300x200?text=Puressha"},
            {"id": "0259","word": "あつらえる","reading": "あつらえる","meaning_cn": "定做，定制，特制","synonyms": ["オーダーメイド", "特注", "量身定做", "手作り"],"antonyms": ["既製", "量産", "標準", "一般的"],"collocations": ["服をあつらえる", "帽子をあつらえる", "あつらえたケーキ", "オーダーメイドであつらえる"],"examples": [{"jp": "まあ、お客様のためにあつらえたようなお帽子。お似合いですよ。","cn": "来，这是特意为您定制的帽子，很适合您哦。"}],"image": "https://placehold.co/300x200?text=Atsuraeru"},
            {"id": "0260","word": "こしらえる","reading": "こしらえる","meaning_cn": "准备，预备，制作，筹措","synonyms": ["作る", "準備する", "用意する", "調達する"],"antonyms": ["破棄する", "捨てる", "中止する", "撤去する"],"collocations": ["料理をこしらえる", "会場をこしらえる", "道具をこしらえる", "宴席をこしらえる"],"examples": [{"jp": "わざわざ母が、この日のためにこしらえてくれたちらし寿司だ。美味しい。","cn": "这是妈妈特意为今天准备的散寿司，真好吃。"}],"image": "https://placehold.co/300x200?text=Koshiraeru"},
            {"id": "0261","word": "弥生","reading": "やよい","meaning_cn": "弥生（日本古历三月），弥生时代","synonyms": ["三月", "弥生時代", "春", "やよい月"],"antonyms": ["他の時代", "他の月", "冬", "秋"],"collocations": ["弥生時代", "弥生の花", "弥生三月", "弥生時代の遺跡"],"examples": [{"jp": "弥生時代の人じゃないんだから、家ではテレビを見てもいいじゃん。","cn": "又不是弥生时代的人，在家看电视也没关系嘛。"}],"image": "https://placehold.co/300x200?text=Yoyoi"},
            {"id": "0262","word": "飛鳥","reading": "あすか","meaning_cn": "飞鸟（日本地名），飞鸟时代","synonyms": ["飛鳥時代", "あすか時代", "古代", "奈良時代以前"],"antonyms": ["近世", "近代", "現代", "平成時代"],"collocations": ["飛鳥時代", "飛鳥の遺跡", "聖徳太子", "遣隋使"],"examples": [{"jp": "聖徳太子と小野妹子は、飛鳥時代の代表的な人物だ。","cn": "圣德太子和小野妹子是飞鸟时代的代表性人物。"}],"image": "https://placehold.co/300x200?text=Asuka"},
