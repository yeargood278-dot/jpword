    {"id": "0202","word": "カテゴリー","reading": "カテゴリー","meaning_cn": "类别，分类，范畴","synonyms": ["種類", "分野", "分類", "項目"],"antonyms": ["混合", "雑然", "無分類"],"collocations": ["カテゴリーを分ける", "新しいカテゴリーを設ける", "カテゴリー別に整理"],"examples": [{"jp": "新しいブログを開設しようと思う。カテゴリーは日記、学校、趣味、食べ物、つぶやきの4種類にしよう。","cn": "我想开设一个新博客，打算将类别分为日记、学校、兴趣、美食、碎碎念四种。"}],"image": "https://placehold.co/300x200?text=Kategorii"},
    {"id": "0203","word": "ガセボイル","reading": "ガセボイル","meaning_cn": "煽动，挑唆，起哄","synonyms": ["扇動する", "挑発する", "かき立てる"],"antonyms": ["鎮める", "説得する", "和解させる"],"collocations": ["他人をガセボイルする", "喧嘩をガセボイルする", "大衆をガセボイル"],"examples": [{"jp": "上司が気に食わないので、同僚や後輩を巻き込んでガセボイルすることにした。","cn": "因为看上司不顺眼，所以决定煽动同事和后辈一起起哄。"}],"image": "https://placehold.co/300x200?text=Gaseboiru"},
    {"id": "0204","word": "生地","reading": "きじ","meaning_cn": "布料，衣料，质地","synonyms": ["布地", "素材", "地肌", "織物"],"antonyms": ["加工品", "成品", "完成品"],"collocations": ["テーブルの生地", "服の生地", "柔らかい生地", "生地の質感"],"examples": [{"jp": "このコートは、羊毛の生地で作られていて、とても暖かい。","cn": "这件大衣是用羊毛面料做的，非常暖和。"}],"image": "https://placehold.co/300x200?text=Kiji"},
    {"id": "0205","word": "几帳面","reading": "きちょうめん","meaning_cn": "一丝不苟，整洁，严谨","synonyms": ["神経質", "整然とした", "厳格", "丁寧"],"antonyms": ["大雑把", "だらけた", "不注意", "雑然"],"collocations": ["几帳面な人", "几帳面に整理", "几帳面な性格", "几帳面な仕事ぶり"],"examples": [{"jp": "几帳面な私の彼女は、パソコンの向きや位置をいつも決まった場所や角度できちっと整えている。","cn": "我那一丝不苟的女朋友，总是把电脑的朝向和位置放在固定的地方、摆成固定角度，整理得整整齐齐。"}],"image": "https://placehold.co/300x200?text=Kichoumen"},
    {"id": "0206","word": "華奢","reading": "はなびら","meaning_cn": "纤细，苗条，小巧玲珑","synonyms": ["スリム", "細身", "繊細", "小柄"],"antonyms": ["ぽっちゃり", "太った", "骨太", "丈夫"],"collocations": ["華奢なからだ", "華奢な腕", "華奢なつくり", "華奢な女性"],"examples": [{"jp": "華奢な彼女の手を掴んだとき、僕が守ってあげなきゃ、と思ったのだった。","cn": "当我握住她纤细的手时，我心想必须要保护好她。"}],"image": "https://placehold.co/300x200?text=Hanabira"},
    {"id": "0207","word": "建前","reading": "たてまえ","meaning_cn": "表面话，场面话，门面话","synonyms": ["お世辞", "建前と本音", "表向き", "見せかけ"],"antonyms": ["本音", "真心", "本心", "実情"],"collocations": ["建前を言う", "建前と本音が違う", "建前で応じる", "建前を破る"],"examples": [{"jp": "「本音と建前ゲーム」なるゲームが実在する。たとえば、女性が友人から恋愛相談を受けているという状況で、建前では「複雑な彼氏なんだね、大変だ」と言うが、本音では「ふざけんな、彼氏いるだけハズだろが」となる。","cn": "存在一种叫“真心话与场面话游戏”的游戏。比如在女性接受朋友恋爱咨询的场景中，场面话会说“他真是个复杂的男朋友呢，你辛苦了”，但真心话却是“别开玩笑了，有男朋友就不错了好吗”。"}],"image": "https://placehold.co/300x200?text=Tatemae"},
    {"id": "0208","word": "垣根","reading": "かきね","meaning_cn": "篱笆，围墙，隔阂","synonyms": ["壁", "溝", "境界", "隔たり"],"antonyms": ["仲睦まじい", "一体化", "連携"],"collocations": ["垣根を越える", "心の垣根", "垣根を作る", "垣根を撤く"],"examples": [{"jp": "親しくなるまでに、越えなきゃいけない垣根が多すぎる。","cn": "要变得亲密无间，需要跨越的隔阂实在太多了。"}],"image": "https://placehold.co/300x200?text=Kakine"},
    {"id": "0209","word": "器用","reading": "きよう","meaning_cn": "灵巧，手巧，多才多艺","synonyms": ["腕がいい", "上手", "多芸", "機敏"],"antonyms": ["不器用", "手笨", "鈍感", "笨拙"],"collocations": ["器用な人", "手先が器用", "器用に生きる", "器用なことをする"],"examples": [{"jp": "私は手先が器用じゃないので、折り紙がとても苦手だ。鶴すら折れない。","cn": "我手不巧，非常不擅长折纸，连纸鹤都折不好。"}],"image": "https://placehold.co/300x200?text=Kiyou"},
    {"id": "0210","word": "行儀悪い","reading": "ぎょうぎわるい","meaning_cn": "举止不端，没礼貌，行为恶劣","synonyms": ["無作法", "品が無い", "躾のなっていない", "育ちが悪い"],"antonyms": ["行儀がいい", "礼儀正しい", "丁寧", "上品"],"collocations": ["行儀が悪い子供", "行儀が悪い行為", "食事の行儀が悪い", "行儀が悪くて失礼"],"examples": [{"jp": "食事の時の行儀の悪さで、その人の育ってきた環境を想像することができる。","cn": "从吃饭时的不良举止，就能想象出那个人成长的环境。"}],"image": "https://placehold.co/300x200?text=Gyougiwarui"},
