[{"id": "0001","word": "上品","reading": "じょうひん","meaning_cn": "高雅，有品位","synonyms": ["エレガント", "シック", "淑やか", "物静か"],"antonyms": ["下品", "いやらしい"],"collocations": ["上品な仕草", "上品な食べ方", "上品なお嬢さん"],"examples": [{"jp": "彼女の立ち居振る舞いはとても上品だ。","cn": "她的举止非常高雅。"}],"image": "https://placehold.co/300x200?text=Jouhin"},{"id": "0002","word": "リベンジ","reading": "りべんじ","meaning_cn": "复仇，报复","synonyms": ["復讐する", "仕返しをする"],"antonyms": [],"collocations": ["敵にリベンジする", "リベンジを果たす"],"examples": [{"jp": "彼は前回の敗北に対してリベンジを果たした。","cn": "他为上次的失败成功复仇了。"}],"image": "https://placehold.co/300x200?text=Ribenji"},{"id": "0003","word": "ファンクション","reading": "ふぁんくしょん","meaning_cn": "功能，作用","synonyms": ["機能"],"antonyms": [],"collocations": [],"examples": [{"jp": "このスマホのファンクションは非常に豊富だ。","cn": "这款手机的功能非常丰富。"}],"image": "https://placehold.co/300x200?text=Fankushon"},{"id": "0004","word": "コツ","reading": "こつ","meaning_cn": "诀窍，窍门，要领","synonyms": ["テクニック", "スキル", "要領"],"antonyms": [],"collocations": ["コツを掴む"],"examples": [{"jp": "この料理の作り方のコツを教えてください。","cn": "请告诉我这道菜的制作诀窍。"}],"image": "https://placehold.co/300x200?text=Kotsu"},{"id": "0005","word": "リーダーシップ","reading": "りーだーしっぷ","meaning_cn": "领导力，领导能力","synonyms": ["統率力", "指導力", "リードする", "チームリーダー", "キャプテン"],"antonyms": [],"collocations": ["リーダーシップを発揮する"],"examples": [{"jp": "彼はチームの中で強いリーダーシップを発揮した。","cn": "他在团队中发挥了强大的领导力。"}],"image": "https://placehold.co/300x200?text=Ridashippu"},{"id": "0006","word": "ジンクス","reading": "じんくす","meaning_cn": "迷信，禁忌，不祥的预兆","synonyms": ["迷信"],"antonyms": [],"collocations": ["ジンクスを破る"],"examples": [{"jp": "この遊園地の観覧車の中でキスをすると、そのカップルは一年以内に別れるというジンクスがある。","cn": "有一个迷信说法是，在这个游乐园的摩天轮里接吻的情侣，会在一年内分手。"}],"image": "https://placehold.co/300x200?text=Jinkusu"},{"id": "0007","word": "ボーダーライン","reading": "ぼーだーらいん","meaning_cn": "边界线，界限，分界线","synonyms": ["境界線"],"antonyms": [],"collocations": ["ボーダーラインを超える"],"examples": [{"jp": "両国のボーダーラインには多くの監視カメラが設置されている。","cn": "两国的边界线上安装了许多监控摄像头。"}],"image": "https://placehold.co/300x200?text=Bodarain"},{"id": "0008","word": "スムーズ","reading": "すむーず","meaning_cn": "顺利，流畅，平滑","synonyms": ["円滑"],"antonyms": [],"collocations": ["スムーズにいく", "スムーズに進む"],"examples": [{"jp": "今日の会議はスムーズに進んだ。","cn": "今天的会议顺利进行了。"}],"image": "https://placehold.co/300x200?text=Sumuzu"},{"id": "0009","word": "アグレッシブ","reading": "あぐれっしぶ","meaning_cn": "积极的，攻击性的，激进的","synonyms": ["積極的", "攻撃的"],"antonyms": [],"collocations": ["アグレッシブな人"],"examples": [{"jp": "『猟奇的な彼女』の “彼女” は、すごくアグレッシブな女性だよね。","cn": "《我的野蛮女友》里的 “女友”，是个非常泼辣的女生呢。"}],"image": "https://placehold.co/300x200?text=Agureshibu"},{"id": "0010","word": "エッセンス","reading": "えっせんす","meaning_cn": "精华，精髓，本质","synonyms": ["エキス", "本質"],"antonyms": [],"collocations": ["物理のエッセンスが詰まっている本", "バニラエッセンス"],"examples": [{"jp": "この本には人生のエッセンスが詰まっている。","cn": "这本书里蕴含着人生的精髓。"}],"image": "https://placehold.co/300x200?text=Essensu"},{"id": "0011","word": "~ イズム","reading": "いずむ","meaning_cn": "～主义，～学说，～风格","synonyms": ["主義", "流", "~ なり"],"antonyms": [],"collocations": ["エゴイズムを追求する", "テロリズムを憎む"],"examples": [{"jp": "エゴイズムを追求すると友達がいなくなる。","cn": "一味追求利己主义的话，就会没有朋友。"}],"image": "https://placehold.co/300x200?text=Izumu"},{"id": "0012","word": "粋","reading": "いき","meaning_cn": "潇洒，风雅，帅，有风度","synonyms": ["おしゃれ", "風流", "スマート", "格好いい", "洗練"],"antonyms": ["野暮", "無粋"],"collocations": [],"examples": [{"jp": "この、春画における人肌の鮮やかな桃色こそが、江戸の「粋」だ。","cn": "春宫图中那鲜活的肌肤桃色，才正是江户时代的风雅之美。"}],"image": "https://placehold.co/300x200?text=Iki"},{"id": "0013","word": "躾","reading": "しつけ","meaning_cn": "教养，管教，管教方式","synonyms": ["礼儀作法", "マナー", "エチケット"],"antonyms": [],"collocations": ["躾がなっていない", "子どもの躾", "ペットの躾", "躾が厳しい"],"examples": [{"jp": "この子は躾がいいね、挨拶もきちんとする。","cn": "这个孩子很有教养呢，打招呼也很得体。"}],"image": "https://placehold.co/300x200?text=Shitsuke"},{"id": "0014","word": "愛想","reading": "あいそ","meaning_cn": "和蔼，亲切，招待，应酬","synonyms": [],"antonyms": [],"collocations": ["愛想がいい", "愛想が悪い", "愛想が尽きる", "愛想笑い"],"examples": [{"jp": "あの店員さんは愛想がいいので、気軽に質問できる。","cn": "那个店员很亲切，所以可以轻松地提问。"}],"image": "https://placehold.co/300x200?text=Aiso"},{"id": "0015","word": "愛嬌","reading": "あいきょう","meaning_cn": "可爱之处，讨人喜欢的样子，亲和力","synonyms": [],"antonyms": [],"collocations": ["愛嬌がある", "愛嬌たっぷりに話す", "愛嬌を振りまく"],"examples": [{"jp": "男は度胸、女は愛嬌。","cn": "男人要有胆量，女人要有魅力。"}],"image": "https://placehold.co/300x200?text=Aikyou"},{"id": "0016","word": "イデオロギー","reading": "いでおろぎー","meaning_cn": "意识形态，思想体系，理念","synonyms": [],"antonyms": [],"collocations": ["イデオロギーを持つ", "イデオロギーを捨てる", "イデオロギーを絶対とする"],"examples": [{"jp": "イデオロギーとは心の燃料だ。","cn": "意识形态是心灵的燃料。"}],"image": "https://placehold.co/300x200?text=Ideorogi"},{"id": "0017","word": "アイデンティティ","reading": "あいでんてぃてぃー","meaning_cn": "身份，同一性，认同","synonyms": ["自己同一性", "ID", "アイデンティファイ", "ID カード"],"antonyms": [],"collocations": ["アイデンティティを確立する", "アイデンティティを形成する", "アイデンティティを保つ"],"examples": [{"jp": "オタクであるということは、もはや彼のアイデンティティになっている。","cn": "作为一名宅男，这早已成为了他的身份标签。"}],"image": "https://placehold.co/300x200?text=Aidentiti"},{"id": "0018","word": "ジレンマ","reading": "じれんま","meaning_cn": "困境，两难境地","synonyms": ["葛藤", "板挟み"],"antonyms": [],"collocations": ["ジレンマに苦しむ", "ジレンマに陥る"],"examples": [{"jp": "親友の彼氏を好きになっちゃったの、ジレンマだねえ。","cn": "我喜欢上了闺蜜的男朋友，真是陷入两难了。"}],"image": "https://placehold.co/300x200?text=Jirenma"},{"id": "0019","word": "ちなみに","reading": "ちなみに","meaning_cn": "顺便说一下，附带一提","synonyms": [],"antonyms": [],"collocations": [],"examples": [{"jp": "浅草寺は雷門が有名な、古いお寺です。ちなみに、浅草寺の近くにあるジェラート屋さんはとても美味しいのでオススメです。","cn": "浅草寺是因雷门而闻名的古老寺庙。顺便一提，浅草寺附近的那家冰淇淋店非常好吃，推荐大家去尝尝。"}],"image": "https://placehold.co/300x200?text=Chinami"},{"id": "0020","word": "ついでに","reading": "ついでに","meaning_cn": "顺便，顺手，就便","synonyms": ["ついでに言うと"],"antonyms": [],"collocations": [],"examples": [{"jp": "スーパー行くの？私の分も買ってきてよ、ついでじゃん。","cn": "你要去超市吗？顺便帮我也买一份呗，反正顺路嘛。"}],"image": "https://placehold.co/300x200?text=Tsuideni"},{"id": "0021","word": "もしくは","reading": "もしくは","meaning_cn": "或者，或是","synonyms": ["あるいは", "また", "または"],"antonyms": [],"collocations": [],"examples": [{"jp": "空いてる日ですか？4 日か、もしくは 5 日なら大丈夫です。","cn": "你有空的日子吗？4 号或者 5 号的话我都可以。"}],"image": "https://placehold.co/300x200?text=Moshikuwa"},{"id": "0022","word": "一方","reading": "いっぽう","meaning_cn": "另一方面，反之","synonyms": ["他方", "一方で", "方や"],"antonyms": [],"collocations": [],"examples": [{"jp": "アメリカの NASA は高性能なボールペンを開発した。一方、ロシアは鉛筆を使った。","cn": "美国国家航空航天局研发出了高性能的圆珠笔。另一方面，俄罗斯则是用了铅笔。"}],"image": "https://placehold.co/300x200?text=Ippou"},{"id": "0023","word": "いわば","reading": "いわば","meaning_cn": "可以说，不妨说","synonyms": ["言ってみれば"],"antonyms": [],"collocations": [],"examples": [{"jp": "人生とは、いわば後悔という船旅だ。","cn": "人生，可以说是一场名为后悔的乘船旅行。"}],"image": "https://placehold.co/300x200?text=Iwaba"},{"id": "0024","word": "フォロー","reading": "ふぉろー","meaning_cn": "跟进，支援，关注","synonyms": ["カバー"],"antonyms": [],"collocations": ["人がフォローする", "ツイッターでフォローする"],"examples": [{"jp": "部長が先に気付いて、私のミスをフォローしてくれた。","cn": "部长先察觉到了，帮我补救了犯下的失误。"}],"image": "https://placehold.co/300x200?text=Forou"},{"id": "0025","word": "カバー","reading": "かばー","meaning_cn": "掩护，弥补，翻唱","synonyms": ["フォロー"],"antonyms": [],"collocations": ["ブックカバー", "物でカバーする"],"examples": [{"jp": "数学はダメだけど、英語で失点をカバーできるからね。","cn": "数学虽然不行，但我可以用英语的成绩来弥补失分。"}],"image": "https://placehold.co/300x200?text=Kaba"},{"id": "0026","word": "オリエンテーション","reading": "おりえんてーしょん","meaning_cn": "迎新会，入职培训，定向","synonyms": ["ガイダンス", "オリエンテーリング", "新入生", "新入社員"],"antonyms": [],"collocations": ["オリエンテーションに参加する"],"examples": [{"jp": "これから入学時オリエンテーションを開催いたしますので、新入生の方々は体育館へお越しください。","cn": "接下来将要举办入学迎新会，新生们请到体育馆集合。"}],"image": "https://placehold.co/300x200?text=Orienteshon"},{"id": "0027","word": "ガイダンス","reading": "がいだんす","meaning_cn": "指导，指南，说明会","synonyms": ["オリエンテーション", "初回ガイダンス", "説明する"],"antonyms": [],"collocations": [],"examples": [{"jp": "画面に表示されるガイダンスに従って入力してください。","cn": "请按照屏幕上显示的指引进行输入操作。"}],"image": "https://placehold.co/300x200?text=Gaidasu"},{"id": "0028","word": "あはれ","reading": "あはれ","meaning_cn": "感慨，哀愁，情趣","synonyms": ["おかし", "趣き", "情緒"],"antonyms": [],"collocations": ["もののあはれを感じる", "異国情緒", "情緒あふれる庭"],"examples": [{"jp": "こうして一人寂しく夜の海で月を見ていると、もののあはれを感じる。","cn": "这样独自一人落寞地在夜晚的海边望月，便会生出物哀之情。"}],"image": "https://placehold.co/300x200?text=Ahare"},{"id": "0029","word": "おかし","reading": "おかし","meaning_cn": "风趣，韵味，诙谐","synonyms": ["あはれ", "趣き", "情緒"],"antonyms": [],"collocations": [],"examples": [{"jp": "この寒いなか、桜が狂い咲きしている。なんとも「おかし」だねえ。","cn": "这么冷的天，樱花却反常地盛开了。真是别有一番韵味啊。"}],"image": "https://placehold.co/300x200?text=Okashi"},{"id": "0030","word": "さび / わび","reading": "さび / わび","meaning_cn": "寂 / 侘，侘寂之美","synonyms": [],"antonyms": [],"collocations": ["わびさびが分かる"],"examples": [{"jp": "この句は、良いですね。おっ、わびさびが分かってるね。","cn": "这句俳句很不错呢。哦，你很懂侘寂之美啊。"}],"image": "https://placehold.co/300x200?text=SabiWabi"},{"id": "0031","word": "無常","reading": "むじょう","meaning_cn": "无常，世事无常","synonyms": ["はかない"],"antonyms": [],"collocations": [],"examples": [{"jp": "世の無常を思い、切なくなった。","cn": "想到世事无常，心中便泛起一阵酸楚。"}],"image": "https://placehold.co/300x200?text=Mujou"},{"id": "0032","word": "事故が相次ぐ","reading": "じこがあいつぐ","meaning_cn": "事故接连发生","synonyms": ["多発する", "頻発する", "続く", "立て続けに"],"antonyms": [],"collocations": [],"examples": [{"jp": "この地域では最近、事故が相次いで起きている。","cn": "最近这片区域里，事故接二连三地发生。"}],"image": "https://placehold.co/300x200?text=JikoGaAitsugu"},{"id": "0033","word": "年をごまかす","reading": "としをごまかす","meaning_cn": "隐瞒年龄，谎报岁数","synonyms": ["さばを読む"],"antonyms": ["歳相応"],"collocations": [],"examples": [{"jp": "彼女は実は 35 歳だけど、いつも年をごまかして 28 歳だと言っている。","cn": "她实际已经 35 岁了，却总是谎报年龄说自己 28 岁。"}],"image": "https://placehold.co/300x200?text=ToshiWoGomakasu"},{"id": "0034","word": "うつむく","reading": "うつむく","meaning_cn": "低下头，垂头丧气","synonyms": ["顔を伏せる", "うなだれる"],"antonyms": ["仰ぐ"],"collocations": [],"examples": [{"jp": "みんなの前で自分の秘密を言われたのが恥ずかしくてうつむく。","cn": "自己的秘密在众人面前被说出来，羞得我低下了头。"}],"image": "https://placehold.co/300x200?text=Utsumuku"},{"id": "0035","word": "憧れる","reading": "あこがれる","meaning_cn": "憧憬，向往，羡慕","synonyms": ["理想にする", "片思いする"],"antonyms": [],"collocations": [],"examples": [{"jp": "アニメのかっこいいヒーローに憧れる。","cn": "我憧憬着动画里帅气的英雄角色。"}],"image": "https://placehold.co/300x200?text=Akogareru"},{"id": "0036","word": "飽きる","reading": "あきる","meaning_cn": "厌倦，厌烦，腻烦","synonyms": [],"antonyms": ["はまる", "のめりこむ"],"collocations": [],"examples": [{"jp": "毎日同じものを食べると、さすがに飽きる。","cn": "每天都吃同样的东西，任谁都会感到厌倦。"}],"image": "https://placehold.co/300x200?text=Akiru"},{"id": "0037","word": "あきれる","reading": "あきれる","meaning_cn": "吃惊，惊呆，愕然","synonyms": ["驚く", "絶句する", "呆然とする"],"antonyms": ["感心する", "脱帽する"],"collocations": [],"examples": [{"jp": "人前で平気で彼女とイチャイチャする友人にあきれる。","cn": "朋友在众人面前还能泰然自若地和女友卿卿我我，真让我大跌眼镜。"}],"image": "https://placehold.co/300x200?text=Akireru"},{"id": "0038","word": "呆気にとられる","reading": "あっけにとられる","meaning_cn": "吓呆，愣住，不知所措","synonyms": [],"antonyms": [],"collocations": [],"examples": [{"jp": "友人による突然のゲイ告白で呆気にとられる。","cn": "被朋友突然的同性告白惊得愣在原地。"}],"image": "https://placehold.co/300x200?text=Akkenitorareru"},{"id": "0039","word": "あぐらをかく","reading": "あぐらをかく","meaning_cn": "盘腿坐，坐享其成","synonyms": [],"antonyms": ["正座する", "努力する"],"collocations": [],"examples": [{"jp": "畳の上であぐらをかいて、テレビを見ている。","cn": "我盘着腿坐在榻榻米上看电视。"}],"image": "https://placehold.co/300x200?text=AguraWoKaku"},{"id": "0040","word": "欺く","reading": "あざむく","meaning_cn": "欺骗，蒙骗，糊弄","synonyms": ["騙す", "嘘をつく", "引っかける", "陥れる"],"antonyms": [],"collocations": [],"examples": [{"jp": "変装して警察の目を欺く。","cn": "通过乔装打扮来糊弄警察的视线。"}],"image": "https://placehold.co/300x200?text=Azamuku"},{"id": "0041","word": "でしゃばる","reading": "でしゃばる","meaning_cn": "多嘴多舌，爱管闲事","synonyms": ["口を挟む", "お節介"],"antonyms": [],"collocations": [],"examples": [{"jp": "毛利小五郎は、でしゃばって推理するが、毎回的外れだ。","cn": "毛利小五郎总爱多嘴去推理，但每次都猜不对。"}],"image": "https://placehold.co/300x200?text=Deshabaru"},{"id": "0042","word": "見当がつく","reading": "けんとうがつく","meaning_cn": "推测到，估计到，有头绪","synonyms": ["分かる", "予想がつく"],"antonyms": [],"collocations": [],"examples": [{"jp": "先生がテストに出しそうなところはだいたい見当がつく。","cn": "老师大概会在考试里出哪些题，我基本能猜到。"}],"image": "https://placehold.co/300x200?text=KentouGaTsuku"},{"id": "0043","word": "苛立つ","reading": "いらだつ","meaning_cn": "焦急，烦躁，不耐烦","synonyms": ["むかつく", "怒る", "腹立つ", "イライラする"],"antonyms": ["落ち着く", "穏やか"],"collocations": [],"examples": [{"jp": "彼女は受験のストレスで苛立っている。","cn": "她因为考试的压力而心情烦躁。"}],"image": "https://placehold.co/300x200?text=Iradatsu"},{"id": "0044","word": "色が褪せる","reading": "いろがあせる","meaning_cn": "褪色，失去光泽，淡忘","synonyms": ["薄れる", "風化する"],"antonyms": [],"collocations": ["心に残る"],"examples": [{"jp": "大事な仲間と過ごした日々は色が褪せない。","cn": "和重要的伙伴一同度过的时光，永远不会褪色。"}],"image": "https://placehold.co/300x200?text=IroGaAseru"},{"id": "0045","word": "値する","reading": "あたいする","meaning_cn": "值得，配得上","synonyms": ["匹敵する", "価値がある"],"antonyms": [],"collocations": [],"examples": [{"jp": "ワールドカップでの優勝の素晴らしさはオリンピックの金メダルに値する。","cn": "世界杯夺冠的荣耀，配得上一枚奥运会金牌。"}],"image": "https://placehold.co/300x200?text=Ataisuru"},{"id": "0046","word": "当たる","reading": "あたる","meaning_cn": "撞上，命中，中奖","synonyms": ["ぶつかる", "突き当り"],"antonyms": ["外れる", "それる"],"collocations": [],"examples": [{"jp": "宝くじで一億円当たる。","cn": "买彩票中了一亿日元。"}],"image": "https://placehold.co/300x200?text=Ataru"},{"id": "0047","word": "行き詰まる","reading": "いきづまる","meaning_cn": "陷入僵局，走投无路","synonyms": ["滞る"],"antonyms": [],"collocations": [],"examples": [{"jp": "問題を解決できず行き詰まる。","cn": "无法解决问题，陷入了僵局。"}],"image": "https://placehold.co/300x200?text=Ikizumaru"},{"id": "0047","word": "扱う","reading": "あつかう","meaning_cn": "对待，处理，操作","synonyms": ["みなす", "接する"],"antonyms": [],"collocations": [],"examples": [{"jp": "ナルトは幼い頃、周りの人々にバケモノのように扱われていた。","cn": "鸣人小时候，被周围的人当作怪物一样对待。"}],"image": "https://placehold.co/300x200?text=Atsukau"},{"id": "0047","word": "当てはまる","reading": "あてはまる","meaning_cn": "适用，适合，符合","synonyms": ["一致する", "合致する", "合う", "適する"],"antonyms": [],"collocations": [],"examples": [{"jp": "日本語を聞いて問題の空欄に当てはまるものを答える。","cn": "听日语录音，填写适合填入题目空格的答案。"}],"image": "https://placehold.co/300x200?text=Attehamaru"},{"id": "0047","word": "甘やかす","reading": "あまやかす","meaning_cn": "娇惯，溺爱，纵容","synonyms": ["かわいがる", "わがまま"],"antonyms": ["しつける", "叱る"],"collocations": [],"examples": [{"jp": "子供を甘やかして育てると、わがままになる。","cn": "娇生惯养孩子的话，他会变得任性妄为。"}],"image": "https://placehold.co/300x200?text=Amayakasu"},{"id": "0047","word": "操る","reading": "あやつる","meaning_cn": "操纵，操控，支配","synonyms": ["使いこなす"],"antonyms": [],"collocations": [],"examples": [{"jp": "ナミは天気を操ることができる。","cn": "娜美能够操控天气。"}],"image": "https://placehold.co/300x200?text=Ayatsuru"},{"id": "0048","word": "いまだに / いまだ","reading": "いまだに / いまだ","meaning_cn": "仍然，还，至今","synonyms": ["まだ"],"antonyms": [],"collocations": [],"examples": [{"jp": "警察が出動して五時間も経ったが、いまだに犯人は捕まっていない。","cn": "警方出动已经过去五个小时了，但犯人至今仍未落网。"}],"image": "https://placehold.co/300x200?text=ImadaniImada"},{"id": "0049","word": "ぼんやり / うやむや / あやふや","reading": "ぼんやり / うやむや / あやふや","meaning_cn": "模糊 / 含糊不清 / 暧昧不明","synonyms": ["曖昧"],"antonyms": ["はっきり"],"collocations": [],"examples": [{"jp": "そのあとどうなったのかは、酔っ払っていたので記憶があやふやです。","cn": "因为当时喝得酩酊大醉，之后发生了什么我记不太清了。"}],"image": "https://placehold.co/300x200?text=BonyariUyamuyaAyafuya"},{"id": "0050","word": "あえて","reading": "あえて","meaning_cn": "敢于，特意，故意","synonyms": [],"antonyms": [],"collocations": ["あえて～する必要はない"],"examples": [{"jp": "何故そこであえて後回しにする？いつやるの？今でしょ！","cn": "为什么非要把那件事往后拖？打算什么时候做？就现在啊！"}],"image": "https://placehold.co/300x200?text=Aete"},{"id": "0051","word": "はっきり","reading": "はっきり","meaning_cn": "清楚，明确，鲜明","synonyms": ["明確"],"antonyms": ["曖昧"],"collocations": ["はっきりさせる", "白黒つける"],"examples": [{"jp": "で、どっちが好きなの？はっきりしてよ！","cn": "说啊，你到底喜欢哪一个？给我说清楚！"}],"image": "https://placehold.co/300x200?text=Hakkiri"},{"id": "0052","word": "あくどい商売","reading": "あくどいしょうばい","meaning_cn": "黑心买卖，不正当生意","synonyms": [],"antonyms": [],"collocations": [],"examples": [{"jp": "そうやって不安を煽って物を売りつけるなんて、あくどい商売ね。","cn": "靠煽动他人不安的情绪来推销商品，真是黑心的买卖。"}],"image": "https://placehold.co/300x200?text=AkudoiShoubai"},{"id": "0053","word": "賢い","reading": "かしこい","meaning_cn": "聪明，机灵，巧妙","synonyms": ["ずる賢い", "スマートなやり方"],"antonyms": [],"collocations": [],"examples": [{"jp": "夏休みの宿題を得意分野別に分担するの、賢いやり方でしょう。","cn": "按照擅长的科目来分工暑假作业，真是个聪明的办法。"}],"image": "https://placehold.co/300x200?text=Kashikoi"},{"id": "0054","word": "みすぼらしい格好","reading": "みすぼらしいかっこう","meaning_cn": "寒酸的打扮，破旧的装束","synonyms": ["貧乏くさい", "卑しい", "いやらしい"],"antonyms": [],"collocations": [],"examples": [{"jp": "シンデレラの服装は、「みすぼらしい」の代表的な例だ。","cn": "灰姑娘的装扮，是 “寒酸” 的典型例子。"}],"image": "https://placehold.co/300x200?text=MisuborashiiKakkou"},{"id": "0055","word": "厚かましい","reading": "あつかましい","meaning_cn": "厚脸皮，无耻，不要脸","synonyms": ["ずうずうしい"],"antonyms": [],"collocations": ["厚かましい態度", "ずうずうしい性格"],"examples": [{"jp": "なんでおばちゃん世代には、厚かましい人が多いのだろう。","cn": "为什么阿姨辈的人里，厚脸皮的人这么多呢。"}],"image": "https://placehold.co/300x200?text=Atsukamashii"},{"id": "0056","word": "危うく","reading": "あやうく","meaning_cn": "险些，差一点","synonyms": ["もう少しで"],"antonyms": [],"collocations": ["危うく～するところだった"],"examples": [{"jp": "危うくラブコメの主人公になるところだった。","cn": "我差点就成了恋爱喜剧的男主角。"}],"image": "https://placehold.co/300x200?text=Ayauku"},{"id": "0057","word": "おおざっぱ","reading": "おおざっぱ","meaning_cn": "粗略，粗糙，马虎","synonyms": [],"antonyms": ["細かい", "神経質な"],"collocations": ["大雑把な性格", "おおざっぱに話す"],"examples": [{"jp": "うん、まあ、おおざっぱに言うとそういうこと。","cn": "嗯，嘛，粗略来讲就是这么回事。"}],"image": "https://placehold.co/300x200?text=Oozappa"},{"id": "0058","word": "鮮やか","reading": "あざやか","meaning_cn": "鲜艳，鲜明，巧妙","synonyms": ["ビビッド", "はっきりした"],"antonyms": [],"collocations": ["鮮やかな色", "ビビッドカラー"],"examples": [{"jp": "この鮮やかな配色が目を引くんだ。","cn": "这种鲜艳的配色很吸引眼球。"}],"image": "https://placehold.co/300x200?text=Azayaka"},{"id": "0059","word": "端的","reading": "たんてき","meaning_cn": "简短，简明，直截了当","synonyms": [],"antonyms": [],"collocations": ["端的に言えば", "端的に言うと"],"examples": [{"jp": "まあ、端的に言うと浮気されたのよ。","cn": "嘛，简单来说就是我被劈腿了。"}],"image": "https://placehold.co/300x200?text=Tanteki"},{"id": "0060","word": "なめらか","reading": "なめらか","meaning_cn": "光滑，流畅，顺滑","synonyms": ["流暢に話す"],"antonyms": ["ざらざらした"],"collocations": ["なめらかな口どけ"],"examples": [{"jp": "ここで小麦粉と牛乳を一緒にして、なめらかになるまで混ぜてください。","cn": "请在这里把面粉和牛奶混合在一起，搅拌至质地顺滑。"}],"image": "https://placehold.co/300x200?text=Nameraka"},{"id": "0061","word": "キャリア","reading": "きゃりあ","meaning_cn": "职业生涯，经历，履历","synonyms": ["キャリアウーマン", "キャリアデザイン"],"antonyms": [],"collocations": ["キャリアを積む"],"examples": [{"jp": "彼女は海外で豊富なキャリアを積んできた。","cn": "她在海外积累了丰富的职场履历。"}],"image": "https://placehold.co/300x200?text=Kyaria"},{"id": "0062","word": "居眠り","reading": "いねむり","meaning_cn": "打盹，打瞌睡","synonyms": ["仮眠を取る", "うたた寝をする"],"antonyms": [],"collocations": ["居眠り運転"],"examples": [{"jp": "授業中に居眠りをすると、先生に注意される。","cn": "上课打瞌睡的话，会被老师提醒。"}],"image": "https://placehold.co/300x200?text=Inemuri"},{"id": "0063","word": "サイン","reading": "さいん","meaning_cn": "签名，信号，迹象","synonyms": ["署名する", "合図を送る"],"antonyms": [],"collocations": ["サインをもらう", "サインをする", "サインを送る"],"examples": [{"jp": "人気歌手のサインをもらうために、長い列に並んでいる。","cn": "为了得到人气歌手的签名，大家排起了长队。"}],"image": "https://placehold.co/300x200?text=Sain"},{"id": "0064","word": "きざ","reading": "きざ","meaning_cn": "装腔作势，故作姿态","synonyms": ["格好づける"],"antonyms": [],"collocations": ["きざなやつ", "きざな言い方"],"examples": [{"jp": "あの人の話し方はちょっときざだと思わない？","cn": "你不觉得那个人的说话方式有点装腔作势吗？"}],"image": "https://placehold.co/300x200?text=Kiza"},{"id": "0065","word": "ライバル","reading": "らいばる","meaning_cn": "对手，竞争者","synonyms": ["敵", "宿敵", "天敵"],"antonyms": ["仲間", "相棒", "味方"],"collocations": ["ライバル意識"],"examples": [{"jp": "彼は私の仕事上のライバルだが、プライベートでは親友だ。","cn": "他是我工作上的竞争对手，但私下里是我的好朋友。"}],"image": "https://placehold.co/300x200?text=Raibaru"},{"id": "0066","word": "あべこべ","reading": "あべこべ","meaning_cn": "相反，颠倒，正反颠倒","synonyms": ["逆さま", "反対"],"antonyms": [],"collocations": [],"examples": [{"jp": "言ってることとやってることがあべこべだ。","cn": "他说的和做的完全是两码事。"}],"image": "https://placehold.co/300x200?text=Abekobe"},{"id": "0067","word": "オリジナル","reading": "おりじなる","meaning_cn": "原创，原版，独创","synonyms": ["本家", "オリジナリティ"],"antonyms": [],"collocations": [],"examples": [{"jp": "この曲のオリジナルは ZOO のものだ。","cn": "这首歌的原版是 ZOO 演唱的。"}],"image": "https://placehold.co/300x200?text=Original"},{"id": "0068","word": "インフレ","reading": "いんふれ","meaning_cn": "通货膨胀，物价上涨","synonyms": ["右肩上がり"],"antonyms": ["デフレ"],"collocations": [],"examples": [{"jp": "戦闘系マンガでは、主人公の強さがインフレを起こすのは定番だ。","cn": "战斗类漫画里，主角的实力不断飙升是固定套路。"}],"image": "https://placehold.co/300x200?text=Infure"},{"id": "0069","word": "ナルシスト","reading": "なるしすと","meaning_cn": "自恋者，自我陶醉者","synonyms": ["自信家", "ナルシシズム", "自惚れる", "一目惚れ"],"antonyms": [],"collocations": [],"examples": [{"jp": "『テニスの王子様』の跡部景吾はとんでもないナルシストだが、実力が伴っているので許されてしまう。","cn": "《网球王子》里的迹部景吾是个极度自恋的人，但因为他实力超群，所以大家都能包容他。"}],"image": "https://placehold.co/300x200?text=Narusisuto"},{"id": "0070","word": "コンテクスト","reading": "こんてくすと","meaning_cn": "上下文，语境，背景","synonyms": ["文脈", "エクリチュール"],"antonyms": [],"collocations": [],"examples": [{"jp": "このセリフの意味はコンテクストを考えないと分からない。","cn": "这句话的含义，不结合语境就无法理解。"}],"image": "https://placehold.co/300x200?text=Kontekusuto"},{"id": "0071","word": "~ ざかり","reading": "ざかり","meaning_cn": "～盛期，～鼎盛时期","synonyms": ["盛り", "盛ん", "お盛ん"],"antonyms": [],"collocations": ["遊び盛りの子供", "花ざかりの君たちへ", "働き盛り"],"examples": [{"jp": "彼はまだ働き盛りなのに、早く引退したいと言っている。","cn": "他明明还处在事业的鼎盛期，却总说想早点退休。"}],"image": "https://placehold.co/300x200?text=Zakari"},{"id": "0072","word": "指切り","reading": "ゆびきり","meaning_cn": "拉钩，勾手指约定","synonyms": ["約束"],"antonyms": [],"collocations": [],"examples": [{"jp": "指切りげんまん嘘付いたら針千本飲ます、指切った！","cn": "拉钩上吊一百年不许变，说谎的人要吞一千根针，拉钩了！"}],"image": "https://placehold.co/300x200?text=Yubikiri"},{"id": "0073","word": "箇条書き","reading": "かじょうがき","meaning_cn": "分条列举，分项列举","synonyms": [],"antonyms": ["文章"],"collocations": [],"examples": [{"jp": "自分の長所と短所について、箇条書きで書いてください。","cn": "请分条列举出你的优点和缺点。"}],"image": "https://placehold.co/300x200?text=Kajyougaki"},{"id": "0074","word": "相場","reading": "そうば","meaning_cn": "行情，市价，普遍看法","synonyms": ["為替レート"],"antonyms": [],"collocations": [],"examples": [{"jp": "新品で買ったゲームでも、中古相場だと半額でしか売れない。","cn": "就算是新买的游戏，按二手市场行情也只能卖到半价。"}],"image": "https://placehold.co/300x200?text=Souba"},{"id": "0075","word": "吟味","reading": "ぎんみ","meaning_cn": "斟酌，推敲，筛选","synonyms": ["検討", "反芻"],"antonyms": [],"collocations": [],"examples": [{"jp": "お金がないので、よく吟味したうえで一つだけ新作ゲームを買うことにした。","cn": "因为没钱，我再三斟酌后决定只买一款新游戏。"}],"image": "https://placehold.co/300x200?text=Ginmi"},{"id": "0076","word": "トラウマ","reading": "とらうま","meaning_cn": "心理创伤，精神创伤","synonyms": ["心的外傷"],"antonyms": [],"collocations": ["トラウマになる", "トラウマを克服する"],"examples": [{"jp": "小さい頃に噛まれたのがトラウマで、いまだに犬は苦手です。","cn": "小时候被狗咬过的经历成了心理创伤，我至今还是很怕狗。"}],"image": "https://placehold.co/300x200?text=Torauma"},{"id": "0077","word": "アプローチ","reading": "あぷろーち","meaning_cn": "接近，靠近，交涉","synonyms": ["アピール"],"antonyms": [],"collocations": ["企業にアプローチする", "好きな人にアプローチする"],"examples": [{"jp": "新しいクライアントにアプローチするための計画を立てよう。","cn": "我们来制定一个方案，去和新客户洽谈合作吧。"}],"image": "https://placehold.co/300x200?text=Apurochi"},{"id": "0078","word": "アンビバレンス","reading": "あんびばれんす","meaning_cn": "矛盾心理，正反感情并存","synonyms": ["二律背反", "愛憎半ばする", "ジレンマ"],"antonyms": [],"collocations": [],"examples": [{"jp": "彼氏の浮気を見つけるたび、アンビバレンスな感情に悩まされる。","cn": "每次发现男友出轨，我都会被这种爱恨交织的矛盾情绪折磨。"}],"image": "https://placehold.co/300x200?text=Anbibarensu"},{"id": "0079","word": "ステレオタイプ","reading": "すてれおたいぷ","meaning_cn": "刻板印象，固有观念","synonyms": ["固定観念", "偏見"],"antonyms": [],"collocations": ["ステレオタイプを持つ", "ステレオタイプで人を見る"],"examples": [{"jp": "女性は方向感覚が悪いというのはステレオタイプだ。","cn": "认为女性方向感差，这是一种刻板印象。"}],"image": "https://placehold.co/300x200?text=Sutereotaipu"},{"id": "0080","word": "アイロニー","reading": "あいろにー","meaning_cn": "讽刺，反讽，讽刺意味","synonyms": ["イロニー", "皮肉"],"antonyms": [],"collocations": [],"examples": [{"jp": "消防署内で火事が起きるなんてアイロニーな事件だね。","cn": "消防站里居然发生了火灾，真是件充满讽刺意味的事。"}],"image": "https://placehold.co/300x200?text=Aironi"},{"id": "0081","word": "いずれにせよ / いずれにしても","reading": "いずれにせよ / いずれにしても","meaning_cn": "无论如何，不管怎样","synonyms": ["とにかく", "ともかく"],"antonyms": [],"collocations": [],"examples": [{"jp": "いずれにしても、今日中にすべての CG を集めるのは無理だ。","cn": "不管怎样，今天之内要集齐所有的 CG 是不可能的。"}],"image": "https://placehold.co/300x200?text=IzureniseyoIzurenishitemo"},{"id": "0082","word": "まして","reading": "まして","meaning_cn": "何况，况且，更不用说","synonyms": [],"antonyms": [],"collocations": ["まして～言うまでもない"],"examples": [{"jp": "社会人ですらポケモンをプレイする。まして小学生は言うまでもない。","cn": "连成年人都在玩宝可梦，更何况小学生呢。"}],"image": "https://placehold.co/300x200?text=Mashite"},{"id": "0083","word": "むしろ","reading": "むしろ","meaning_cn": "不如，宁可，倒不如说","synonyms": [],"antonyms": [],"collocations": ["～というよりはむしろ"],"examples": [{"jp": "富士山が世界遺産になったと聞いた。むしろまだなってなかったことが驚きだよ。","cn": "听说富士山入选世界遗产了。倒不如说我惊讶的是它居然现在才入选。"}],"image": "https://placehold.co/300x200?text=Mushiro"},{"id": "0084","word": "かたわら","reading": "かたわら","meaning_cn": "一边… 一边…，同时","synonyms": [],"antonyms": [],"collocations": [],"examples": [{"jp": "漫画家の中には、連載漫画を描くかたわら、同人誌を描いている人も少なくない。","cn": "漫画家当中，不少人一边画连载漫画，一边创作同人志。"}],"image": "https://placehold.co/300x200?text=Katawara"},{"id": "0085","word": "かつ","reading": "かつ","meaning_cn": "并且，而且，同时","synonyms": ["その上"],"antonyms": [],"collocations": [],"examples": [{"jp": "嵐の二宮くんはイケメンでかつ演技もうまい。理想のアイドルだ。","cn": "岚的二宫先生长得帅，而且演技也好，是理想中的偶像。"}],"image": "https://placehold.co/300x200?text=Katsu"},{"id": "0086","word": "アクセント","reading": "あくせんと","meaning_cn": "重音，口音，亮点","synonyms": [],"antonyms": [],"collocations": [],"examples": [{"jp": "この単語のアクセントはどこにあるのか教えてください。","cn": "请告诉我这个单词的重音在哪里。"}],"image": "https://placehold.co/300x200?text=Akusento"},{"id": "0087","word": "イントネーション","reading": "いんとねーしょん","meaning_cn": "语调，声调","synonyms": [],"antonyms": [],"collocations": [],"examples": [{"jp": "同じ文でもイントネーションによって意味が変わることがある。","cn": "就算是同一个句子，语调不同意思也可能会发生变化。"}],"image": "https://placehold.co/300x200?text=Intoneeshon"},{"id": "0088","word": "ニート","reading": "にーと","meaning_cn": "啃老族，不升学不就业不进修的人","synonyms": ["無職", "フリーター", "引きこもり", "オタク"],"antonyms": [],"collocations": [],"examples": [{"jp": "やばい、まだ一つも内定貰えてない、このままじゃニートだ。","cn": "糟糕，我还没拿到任何一家公司的录用通知，再这样下去就要变成啃老族了。"}],"image": "https://placehold.co/300x200?text=Niito"},{"id": "0089","word": "フリーター","reading": "ふりーたー","meaning_cn": "自由职业者，打工族","synonyms": ["バイト"],"antonyms": [],"collocations": [],"examples": [{"jp": "なにこのバイトの募集内容、週 6 日だって。完全にフリーター向けじゃん。","cn": "这打工招聘信息是什么啊，居然要求一周工作 6 天。完全是面向自由打工族的嘛。"}],"image": "https://placehold.co/300x200?text=Furiitaa"},{"id": "0090","word": "引きこもり","reading": "ひきこもり","meaning_cn": "蛰居族，家里蹲","synonyms": ["ヒッキー", "ニート", "オタク"],"antonyms": [],"collocations": ["自室で引きこもる", "不登校になる"],"examples": [{"jp": "あの先生、最近見ないと思ったら仕事のストレスで引きこもりになったらしいよ。","cn": "我还纳闷最近怎么没看到那位老师，原来是因为工作压力变成家里蹲了。"}],"image": "https://placehold.co/300x200?text=Hikikomori"},{"id": "0091","word": "オタク","reading": "おたく","meaning_cn": "宅男，宅女，发烧友","synonyms": ["コミケ", "腐女子"],"antonyms": [],"collocations": ["鉄道オタク", "アニメオタク"],"examples": [{"jp": "確かに俺はオタクだが、ニートでも引きこもりでもないぞ。","cn": "我确实是个宅男，但我既不是啃老族也不是家里蹲。"}],"image": "https://placehold.co/300x200?text=Otaku"},{"id": "0092","word": "当て字","reading": "あてじ","meaning_cn": "假借字，谐音字","synonyms": ["ルビ", "よみがな", "振り仮名をふる"],"antonyms": [],"collocations": [],"examples": [{"jp": "「夜露死苦」と書いて、「よろしく」と読む。これが当て字だ。","cn": "写作 “夜露死苦”，读作 “请多关照”，这就是假借字。"}],"image": "https://placehold.co/300x200?text=Ateji"},{"id": "0093","word": "かるた","reading": "かるた","meaning_cn": "歌牌，纸牌","synonyms": ["かるた大会", "百人一首"],"antonyms": [],"collocations": [],"examples": [{"jp": "かるた取りは、正月に欠かせない遊びだ。","cn": "玩歌牌是新年里必不可少的游戏。"}],"image": "https://placehold.co/300x200?text=Karuta"},{"id": "0094","word": "下駄","reading": "げた","meaning_cn": "木屐","synonyms": ["上履き", "下駄箱", "鼻緒"],"antonyms": [],"collocations": [],"examples": [{"jp": "下駄を履くと、すこし背が高くなる。","cn": "穿上木屐的话，个子会稍微变高一点。"}],"image": "https://placehold.co/300x200?text=Geta"},{"id": "0095","word": "タメ語","reading": "ためご","meaning_cn": "简体，通俗口语，平辈用语","synonyms": ["タメ口"],"antonyms": [],"collocations": ["タメ口をきく", "タメ語で話す"],"examples": [{"jp": "タメ語でいいよ、年は違うけど、同じ学年だもの。","cn": "用通俗口语就好啦，虽然年龄不一样，但我们是同年级的呀。"}],"image": "https://placehold.co/300x200?text=Tamego"},{"id": "0096","word": "荒らす","reading": "あらす","meaning_cn": "糟蹋，破坏，扰乱","synonyms": ["荒れる", "散らかす", "肌荒れ"],"antonyms": [],"collocations": [],"examples": [{"jp": "泥棒が家を荒らす。","cn": "小偷把家里翻得乱七八糟。"}],"image": "https://placehold.co/300x200?text=Arasu"},{"id": "0097","word": "改まった言い方","reading": "あらたまったいいかた","meaning_cn": "正式的说法","synonyms": ["あらためて"],"antonyms": [],"collocations": [],"examples": [{"jp": "「わたし」の改まった言い方は「わたくし」だ。","cn": "“我” 的正式说法是 “わたくし”。"}],"image": "https://placehold.co/300x200?text=AratamattaIikata"},{"id": "0098","word": "咥える","reading": "くわえる","meaning_cn": "叼着，衔着，包含","synonyms": ["加える", "加わる", "ガムを噛む"],"antonyms": [],"collocations": [],"examples": [{"jp": "寝坊したのでパンを咥えたまま走って登校する。","cn": "因为睡过头了，所以叼着面包一路跑去上学。"}],"image": "https://placehold.co/300x200?text=Kuwaeru"},{"id": "0099","word": "身構える","reading": "みがまえる","meaning_cn": "摆好架势，戒备，振作","synonyms": ["準備する"],"antonyms": ["無防備", "不注意"],"collocations": [],"examples": [{"jp": "お化け屋敷でお化けがいつ出てきてもいいように身構える。","cn": "在鬼屋里，为了防备鬼怪随时跳出来而摆好了架势。"}],"image": "https://placehold.co/300x200?text=Migamaeru"},{"id": "0100","word": "かき混ぜる","reading": "かきまぜる","meaning_cn": "搅拌，搅和","synonyms": ["かき回す"],"antonyms": [],"collocations": [],"examples": [{"jp": "コーヒーに砂糖を入れてかき混ぜる。","cn": "往咖啡里加糖并搅拌均匀。"}],"image": "https://placehold.co/300x200?text=Kakimazeru"}]