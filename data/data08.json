    {"id": "0718","word": "かじかむ","reading": "かじかむ","meaning_cn": "冻僵，冻得发麻，抽筋","synonyms": ["痙れる", "麻痺する", "震える", "つっぱる"],"antonyms": ["温まる", "柔らかくなる", "正常になる", "緩む"],"collocations": ["手がかじかむ", "足がかじかむ", "寒さでかじかむ", "かじかんだ指"],"examples": [{"jp": "雪でかじかんだ手を恋人とあたため合うのは、一度は経験したいエピソードの一つだ。","cn": "和恋人互相暖着被雪冻僵的手，是想体验一次的经历之一。"}],"image": "https://placehold.co/300x200?text=Kajikamu"},
    {"id": "0719","word": "板につく","reading": "いたにつく","meaning_cn": "熟练，习惯，上手，得心应手","synonyms": ["身につく", "馴染む", "らしくなる", "自然になる"],"antonyms": ["ぎこちない", "不器用", "慣れない", "下手"],"collocations": ["日本語が板につく", "技術が板につく", "板についてきた", "板につくまで練習"],"examples": [{"jp": "日本語を一年学んで、ようやく板についてきた。","cn": "学了一年日语，终于变得熟练了。"}],"image": "https://placehold.co/300x200?text=Ita ni Tsuku"},
