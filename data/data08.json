[
    {"id": "0701","word": "やわらげる","reading": "やわらげる","meaning_cn": "缓和，软化，使柔和，平息","synonyms": ["柔らかくする", "中和する", "薄める", "和らげる"],"antonyms": ["強める", "激化させる", "硬化させる", "厳しくする"],"collocations": ["雰囲気をやわらげる", "緊張をやわらげる", "やわらげる言葉", "怒りをやわらげる"],"examples": [{"jp": "彼のユーモラスな話が場の雰囲気をやわらげた。","cn": "他幽默的发言缓和了现场的气氛。"}],"image": "https://placehold.co/300x200?text=Yawarakageru"},
    {"id": "0702","word": "融通がきかない","reading": "ゆうずうがきかない","meaning_cn": "死板，不灵活，不通融","synonyms": ["頭がかたい", "偏見がある", "柔軟性がない", "臨機応変でない"],"antonyms": ["融通がきく", "臨機応変", "頭がやわらかい", "応用力がある"],"collocations": ["融通がきかない人", "融通がきかない考え", "融通がきかない態度", "融通がきかない規則"],"examples": [{"jp": "政治を悪くするのは伝統にこだわる融通のきかない人々だ。","cn": "把政治搞坏的是那些拘泥于传统、死板不通融的人。"}],"image": "https://placehold.co/300x200?text=Yuuzuuga Kikanai"},
    {"id": "0703","word": "譲る","reading": "ゆずる","meaning_cn": "让，出让，谦让，让步","synonyms": ["渡す", "あげる", "譲り合う", "屈服する"],"antonyms": ["奪う", "占める", "譲らない", "固持する"],"collocations": ["席を譲る", "利益を譲る", "譲る気持ち", "譲り合う関係"],"examples": [{"jp": "電車で妊婦さんに席を譲ろうとしたが、妊婦さんではなくただの太っている人で気まずくなった。","cn": "我想在电车上给孕妇让座，结果对方只是个胖人，场面变得很尴尬。"}],"image": "https://placehold.co/300x200?text=Yuzuru"},
    {"id": "0704","word": "許す","reading": "ゆるす","meaning_cn": "允许，准许，原谅，宽恕","synonyms": ["受け入れる", "許可する", "認める", "赦す"],"antonyms": ["禁じる", "拒否する", "責める", "非難する"],"collocations": ["誤りを許す", "気を許す", "許す余地", "許される行為"],"examples": [{"jp": "謝罪して謝ることができる人は素晴らしい。その謝罪を笑って許せる人はもっと素晴らしい。","cn": "能道歉认错的人很优秀，而能笑着原谅这份道歉的人更优秀。"}],"image": "https://placehold.co/300x200?text=Yurusu"},
    {"id": "0705","word": "緩む","reading": "ゆるむ","meaning_cn": "变松，松弛，缓和，放宽","synonyms": ["弛む", "緩和する", "ゆるやかになる", "締まらなくなる"],"antonyms": ["きつくなる", "締まる", "強まる", "厳しくする"],"collocations": ["気が緩む", "ベルトが緩む", "規制が緩む", "緊張が緩む"],"examples": [{"jp": "一瞬の気の緩みが大きな事故を引き起こす。","cn": "一瞬间的松懈会引发严重的事故。"}],"image": "https://placehold.co/300x200?text=Yurumu"},
    {"id": "0706","word": "せいぜい","reading": "せいぜい","meaning_cn": "最多，充其量，顶多","synonyms": ["最大限", "高々", "どうせ", "せめて"],"antonyms": ["少なくとも", "最低限", "少なくとも", "最低"],"collocations": ["せいぜい500万円", "せいぜい一周间", "せいぜいそれだけ", "せいぜい程度"],"examples": [{"jp": "あんな傾向ない男の年収なんて、せいぜい500万程度でしょうよ。","cn": "像他那样没什么本事的男人，年收入最多也就五百万日元左右吧。"}],"image": "https://placehold.co/300x200?text=Seizei"},
    {"id": "0707","word": "呼びかける","reading": "よびかける","meaning_cn": "呼吁，号召，呼唤，搭讪","synonyms": ["提起する", "お願いする", "呼び出す", "訴える"],"antonyms": ["無視する", "避ける", "拒絶する", "遠ざける"],"collocations": ["核廃絶を呼びかける", "人々に呼びかける", "呼びかける声", "積極的に呼びかける"],"examples": [{"jp": "世界の人々に核廃絶を呼びかける。","cn": "向世界人民呼吁废除核武器。"}],"image": "https://placehold.co/300x200?text=Yobikakeru"},
    {"id": "0708","word": "よみがえる","reading": "よみがえる","meaning_cn": "复活，复苏，苏醒，重现","synonyms": ["復活する", "蘇起する", "甦る", "思い出される"],"antonyms": ["死亡する", "消滅する", "忘れ去られる", "終わる"],"collocations": ["思い出がよみがえる", "生命がよみがえる", "伝統がよみがえる", "よみがえる時代"],"examples": [{"jp": "母校へ行くとあのころの思い出がよみがえる。","cn": "一回到母校，那时的回忆就会重现。"}],"image": "https://placehold.co/300x200?text=Yomigaeru"},
    {"id": "0709","word": "ざわめく","reading": "ざわめく","meaning_cn": "嘈杂，喧闹，骚动","synonyms": ["ざわつく", "ざわざわする", "騒然とする", "騒々しい"],"antonyms": ["静まる", "沈黙する", "無音", "平穏"],"collocations": ["客席がざわめく", "街がざわめく", "ざわめく人々", "ざわめく雰囲気"],"examples": [{"jp": "前田敦子の突然のAKB卒業宣言に客席がざわめく。","cn": "前田敦子突然宣布从AKB毕业，观众席一片骚动。"}],"image": "https://placehold.co/300x200?text=Zawameku"},
    {"id": "0710","word": "あがる","reading": "あがる","meaning_cn": "紧张，害羞，脸红，激动","synonyms": ["緊張する", "恥ずかしくなる", "赤面する", "興奮する"],"antonyms": ["平気", "冷静", "落ち着く", "泰然とする"],"collocations": ["顔があがる", "緊張してあがる", "あがって話せない", "あがる思い"],"examples": [{"jp": "相手のあまりの美貌にあがってしまってうまく会話することができない。","cn": "对方太过美貌，我紧张得说不出话来。"}],"image": "https://placehold.co/300x200?text=Agaru"},
    {"id": "0711","word": "ぞんざい","reading": "ぞんざい","meaning_cn": "粗暴，粗鲁，草率，轻率","synonyms": ["乱暴", "無謀", "手荒い", "不謹慎"],"antonyms": ["丁寧", "慎重", "謹慎", "優雅"],"collocations": ["ぞんざいに扱う", "ぞんざいな動作", "ぞんざいな仕草", "ぞんざいな態度"],"examples": [{"jp": "そんなぞんざいに扱ってると、すぐに壊してしまうよ。","cn": "这么粗暴地使用，很快就会弄坏的哦。"}],"image": "https://placehold.co/300x200?text=Zonzai"},
