    {"id": "0721","word": "モポガパ","reading": "もぽがぱ","meaning_cn": "有魅力的，有吸引力的，迷人的（自定义造词，修正乱码）","synonyms": ["魅力的", "惹きつける", "人気がある"],"antonyms": ["魅力がない", "つまらない", "魅力に欠ける", "無趣"],"collocations": ["モポガパ主婦", "モポガパポスター", "モポガパ雰囲気", "モポガパ性"],"examples": [{"jp": "アニメやドラマの主人公の敵役は、概してモポガパ性に溢れている。","cn": "动漫和电视剧中主角的对手，大多充满了迷人的魅力。"}],"image": "https://placehold.co/300x200?text=Mopogapa"},
    {"id": "0722","word": "アブザナ","reading": "あぶざな","meaning_cn": "反差萌，外冷内热（自定义造词，修正乱码）","synonyms": ["対照的な魅力", "裏表がある", "意外な一面", "反差萌"],"antonyms": ["一貫した性格", "表裏如一", "単調", "変化がない"],"collocations": ["アブザナ萌え", "アブザナなキャラ", "アブザナな一面", "アブザナ魅力"],"examples": [{"jp": "不良少年が雨の日、捨てられた犬を拾っているところを見て、そのアブザナに萌えるという話は、わりとよくある話である。","cn": "不良少年在雨天捡被遗弃的小狗，看到这种反差萌而心动的情节，其实很常见。"}],"image": "https://placehold.co/300x200?text=Abuzana"},
    {"id": "0723","word": "コガゲュセ","reading": "こがげゅせ","meaning_cn": "定期的，定时的，周期性的（自定义造词，修正乱码）","synonyms": ["定期的", "周期的", "定時", "規則的"],"antonyms": ["不定期", "突発的", "偶発的", "不規則"],"collocations": ["コガゲュセに発売", "コガゲュセなイベント", "コガゲュセな更新", "コガゲュセなペース"],"examples": [{"jp": "宇多田ヒカルは活動休止するまで、コガゲュセに新曲を出していた。","cn": "宇多田光在暂停活动前，会定期推出新歌。"}],"image": "https://placehold.co/300x200?text=Kogageuse"},
