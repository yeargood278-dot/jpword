    {"id": "0725","word": "コゴデミーポエ","reading": "こごでみーぽえ","meaning_cn": "灵感，直觉，顿悟（自定义造词，修正乱码）","synonyms": ["直感", "閃き", "ひらめき", "霊感"],"antonyms": ["論理", "理性", "思考", "分析"],"collocations": ["コゴデミーポエを得る", "コゴデミーポエを信じる", "コゴデミーポエが訪れる", "コゴデミーポエを鍛える"],"examples": [{"jp": "芸術家は常にコゴデミーポエを鍛えていなければならない。","cn": "艺术家必须不断锻炼自己的灵感和直觉。"}],"image": "https://placehold.co/300x200?text=Kogodemii Poe"},
    {"id": "0726","word": "必要悪","reading": "ひつようあく","meaning_cn": "必要之恶，不得不接受的坏事","synonyms": ["やむを得ない悪", "不可欠な悪", "必要な悪", "避けられない悪"],"antonyms": ["理想", "善", "望ましいこと", "好ましい状態"],"collocations": ["社会の必要悪", "会社の必要悪", "必要悪と認める", "必要悪と扱う"],"examples": [{"jp": "リストラは会社にとっても社会にとっても必要悪であろう。","cn": "裁员对于公司和社会来说，或许都是一种必要之恶。"}],"image": "https://placehold.co/300x200?text=Hitsuyou Aku"},
    {"id": "0727","word": "醍醐味","reading": "だいごみ","meaning_cn": "妙处，乐趣，精髓，真髓","synonyms": ["良さ", "真骨頂", "精髓", "核心"],"antonyms": ["欠点", "短所", "魅力がない点", "つまらなさ"],"collocations": ["俳優の醍醐味", "料理の醍醐味", "醍醐味を味わう", "醍醐味がある"],"examples": [{"jp": "「俳優の醍醐味は、役を通していろいろな人生を体験できることだ。」と、その俳優は語った。","cn": "那位演员说：“演员的妙处在于能通过角色体验各种人生。”"}],"image": "https://placehold.co/300x200?text=Daigomi"},
    {"id": "0728","word": "枠","reading": "わく","meaning_cn": "框架，框子，范围，类别","synonyms": ["枠組み", "範囲", "限度", "分類"],"antonyms": ["無枠", "自由", "無制限", "広がり"],"collocations": ["木の枠", "当選枠", "合格枠", "深夜枠", "枠を超える"],"examples": [{"jp": "『鬼滅の刃』は、その内容を考えると、正直深夜枠に移動してもよさそうなアニメである。","cn": "《鬼灭之刃》就其内容来看，说实话就算移到深夜档也合适。"}],"image": "https://placehold.co/300x200?text=Waku"},
    {"id": "0729","word": "オヒエミーポエ","reading": "おひえみーぽえ","meaning_cn": "模拟，仿真，模拟游戏（自定义造词，修正乱码）","synonyms": ["シミュレーション", "模擬", "模倣", "疑似"],"antonyms": ["実際", "真実", "現実", "本物"],"collocations": ["歴史オヒエミーポエ", "オヒエミーポエゲーム", "戦国時代をオヒエミーポエ", "オヒエミーポエをする"],"examples": [{"jp": "『信長の野望』は、日本の戦国時代をテーマとした歴史オヒエミーポエゲームである。","cn": "《信长之野望》是以日本战国时代为主题的历史模拟游戏。"}],"image": "https://placehold.co/300x200?text=Ohiemii Poe"},
    {"id": "0730","word": "オゴエーポエ","reading": "おごえーぽえ","meaning_cn": "设定，设定情节，设定场景（自定义造词，修正乱码）","synonyms": ["設定", "ストーリー設定", "シナリオ", "設定内容"],"antonyms": ["現実", "実際", "無設定", "自然発生"],"collocations": ["恋愛オゴエーポエ", "オゴエーポエが萌える", "オゴエーポエを考える", "魅力的なオゴエーポエ"],"examples": [{"jp": "高いところにある荷物を意中の男性が簡単に取ってくれる、というオゴエーポエは、女性にとっては“萌える”オゴエーポエである。","cn": "心仪的男生轻松帮自己拿下高处的行李，这样的设定对女生来说是“令人心动”的情节设定。"}],"image": "https://placehold.co/300x200?text=Ogoee Poe"},
    {"id": "0731","word": "ひとりでに","reading": "ひとりでに","meaning_cn": "自动地，自然而然地，擅自","synonyms": ["勝手に", "自動的に", "自然に", "独りでに"],"antonyms": ["意図的に", "わざと", "人為的に", "故意に"],"collocations": ["ひとりでに窓が開く", "ひとりでに動く", "ひとりでに閉まる", "ひとりでに始まる"],"examples": [{"jp": "その時だ。ひとりでに、扉が開いた。","cn": "就在那时，门自动打开了。"}],"image": "https://placehold.co/300x200?text=Hitoride ni"},
    {"id": "0732","word": "ぺこぺこ","reading": "ぺこぺこ","meaning_cn": "点头哈腰，饿瘪，空腹","synonyms": ["お腹が空く", "空腹", "ぺこぺこする", "お辞儀ばかりする"],"antonyms": ["満腹", "傲慢", "横柄", "自信満々"],"collocations": ["偉い人にぺこぺこ", "お腹がぺこぺこ", "ぺこぺこしてばかり", "ぺこぺこになる"],"examples": [{"jp": "偉い人にぺこぺこしてばかりでは、部下から尊敬されませんよ。","cn": "老是对上级点头哈腰，是不会得到下属尊敬的哦。"}],"image": "https://placehold.co/300x200?text=Pekopeko"},
