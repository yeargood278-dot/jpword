    {"id": "0713","word": "掻く","reading": "かく","meaning_cn": "抓，搔，挠，刮","synonyms": ["引っ掻く", "こする", "掻きむしる", "削る"],"antonyms": ["撫でる", "保護する", "守る", "覆う"],"collocations": ["痒いところを掻く", "蚊に刺されたところを掻く", "掻いて血が出る", "掻き集める"],"examples": [{"jp": "蚊に刺されたところを掻き過ぎて血が出る。","cn": "把被蚊子咬的地方抓得太用力，流血了。"}],"image": "https://placehold.co/300x200?text=Kaku"},
